{
  "id": "fx_tale",
  "title": "A Fixture",
  "binds": {
    "giver": "a lord",
    "village": "a village"
  },
  "stages": [
    {
      "id": "ask",
      "journal": "Talk to {giver}.",
      "objective": {
        "type": "talk_to",
        "hero": "{giver}"
      },
      "on_complete": {
        "next": "go"
      }
    },
    {
      "id": "go",
      "journal": "Go to {village}.",
      "objective": {
        "type": "defeat_party",
        "spawn": {
          "id": "band",
          "near": "{village}",
          "size": [
            2,
            5
          ],
          "on_defeat": {
            "next": "ask",
            "journal": "You lost."
          }
        }
      },
      "on_complete": {
        "next": "reward"
      }
    }
  ],
  "reward": {
    "regard": 5
  }
}
