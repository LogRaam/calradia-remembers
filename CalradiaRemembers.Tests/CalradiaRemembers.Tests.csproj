<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <!-- Roslyn, SYNTAX ONLY: the Maps fixtures parse the SOURCE of the mod, of Logic and of the SDK to
         regenerate docs/maps and RULES.md, and fail when the committed copy no longer matches. Syntax
         needs no TaleWorlds reference, so the engine-bound mod is mapped like everything else, and unlike
         reflection it keeps the XML doc comments, which are what make a map readable. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="NUnit" Version="4.6.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
    <PackageReference Include="FluentAssertions" Version="8.9.0" />
    <!-- Mono.Cecil reads IL straight from the mod DLL on disk WITHOUT loading or executing it, so the
         otherwise-"untestable" engine-facing assembly becomes statically inspectable here without ever
         dragging the TaleWorlds DLLs into this test process. Backs the engine-registry init guardrail
         (see Guardrails/EngineRegistryInitializationGuardTests). 0.11.x targets netstandard2.0 and loads
         cleanly under this net10.0 test host. -->
    <PackageReference Include="Mono.Cecil" Version="0.11.5" />
  </ItemGroup>

  <!-- The shipped narrative files, copied BESIDE the test assembly so ShippedNarrativeSizeTests can measure
       them from AppContext.BaseDirectory. They used to be located from the test's own [CallerFilePath],
       which is the path the COMPILER saw - fine under `dotnet test`, wrong under NCrunch, which compiles
       from its own workspace copy and does not carry these .txt files into it. Gabriel runs NCrunch, so all
       three tests were red there while green on the command line. Copying them makes the file reachable the
       same way in every runner, and CopyToOutputDirectory is what NCrunch honours. -->
  <ItemGroup>
    <None Include="../CalradiaRemembers/ModuleData/world.txt" Link="ShippedNarrative/world.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../CalradiaRemembers/ModuleData/behavior_guidelines.txt" Link="ShippedNarrative/behavior_guidelines.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../CalradiaRemembers/ModuleData/player_description.txt" Link="ShippedNarrative/player_description.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../CalradiaRemembers/ModuleData/post_history_instructions.txt" Link="ShippedNarrative/post_history_instructions.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CalradiaRemembers.Logic\CalradiaRemembers.Logic.csproj" />
    <!-- The SDK (NpcMemoryService.Core) is engine-agnostic; referencing it lets us unit-test its pure
         wire-format logic (e.g. the SSE response transformer). Newtonsoft.Json comes transitively. -->
    <ProjectReference Include="..\..\LLM Roleplay Service\NpcMemoryService.Core\NpcMemoryService.Core.csproj" />
  </ItemGroup>
  <!-- The subject for whom every gated action teaching renders, shared with the SDK's own VerbCatalogPolicyTests so the
       composition-parity map (Maps/CompositionParityMap) renders both readers' prompts from the very same context. -->
  <ItemGroup>
    <Compile Include="..\..\LLM Roleplay Service\NpcMemoryServiceTests\PermissiveEncounter.cs" Link="Maps/PermissiveEncounter.cs" />
  </ItemGroup>

</Project>
