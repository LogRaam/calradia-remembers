    <Reference Include="TaleWorlds.Engine">
      <HintPath>$(BannerlordGameBinaryDir)\TaleWorlds.Engine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(BannerlordGameBinaryDir)\Newtonsoft.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="TaleWorlds.ScreenSystem">
      <HintPath>$(BannerlordGameBinaryDir)\TaleWorlds.ScreenSystem.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!--
    ─── Auto-deploy to the Bannerlord module after build (single target) ────
    Deploys ONLY the mod's own assemblies plus module content (SubModule.xml,
    GUI prefabs, ModuleData, Sounds). Everything else (TaleWorlds.*, Newtonsoft.Json)
    is already provided by the game; bundling it is redundant and risks version
    drift. No .pdb either — players don't need debug symbols.
    NpcMemoryService.Core uses Newtonsoft.Json (shipped by Bannerlord, 13.0.1) —
    the old System.Text.Json facade tree (which caused assembly-load failures on
    some players' machines) is gone.
  -->
  <Target Name="DeployToBannerlord" AfterTargets="Build">
    <ItemGroup>
      <ModAssemblies   Include="$(TargetDir)CalradiaRemembers.dll;$(TargetDir)CalradiaRemembers.Logic.dll;$(TargetDir)NpcMemoryService.Core.dll" />
      <GuiPrefabFiles  Include="$(ProjectDir)GUI\Prefabs\*.xml" />
      <ModuleDataFiles Include="$(ProjectDir)ModuleData\*.*" />
      <SoundFiles      Include="$(ProjectDir)Sounds\**\*.*" />
    </ItemGroup>

    <MakeDir Directories="$(BannerlordBinaryDir)" />
    <Copy SourceFiles="@(ModAssemblies)"            DestinationFolder="$(BannerlordBinaryDir)"             SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(ProjectDir)..\SubModule.xml" DestinationFolder="$(BannerlordModuleDir)"           SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(GuiPrefabFiles)"           DestinationFolder="$(BannerlordModuleDir)\GUI\Prefabs" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(ModuleDataFiles)"          DestinationFolder="$(BannerlordModuleDir)\ModuleData"  SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(SoundFiles)"               DestinationFolder="$(BannerlordModuleDir)\Sounds\%(RecursiveDir)" SkipUnchangedFiles="true" />

    <Message Text="[CalradiaRemembers] Deployed to $(BannerlordModuleDir)" Importance="high" />
  </Target>

</Project>
