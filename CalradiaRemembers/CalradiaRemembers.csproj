<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>10.0</LangVersion>
    <RootNamespace>CalradiaRemembers</RootNamespace>
    <AssemblyName>CalradiaRemembers</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PlatformTarget>x64</PlatformTarget>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>

    <!--
      OutputPath: where the build puts the DLLs, RELATIVE to this project so it always lands inside the repo
      (the old absolute path was missing the "Bannerlord LLM project" segment and wrote to a stray folder
      OUTSIDE the repo, producing a second divergent build the deploy then shipped stale, v2.4.4 SubModule
      mismatch, 2026-08-31). $(TargetDir) follows this, so DeployToBannerlord now copies the SAME build it just made.
      AppendTargetFrameworkToOutputPath: prevents MSBuild from appending net472\ subdirectory.
      AppendRuntimeIdentifierToOutputPath: prevents platform subfolder (x64\, etc.).
    -->
    <OutputPath>bin\Win64_Shipping_Client\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>

    <!-- Game install paths — single source for every game DLL reference and the
         DeployToBannerlord target. Override BannerlordInstallDir on the command line
         (/p:BannerlordInstallDir=...) for a non-default Steam location. -->
    <BannerlordInstallDir>C:\Program Files (x86)\Steam\steamapps\common\Mount &amp; Blade II Bannerlord</BannerlordInstallDir>
    <BannerlordModulesDir>$(BannerlordInstallDir)\Modules</BannerlordModulesDir>
    <BannerlordModuleDir>$(BannerlordModulesDir)\CalradiaRemembers</BannerlordModuleDir>
    <BannerlordBinaryDir>$(BannerlordModuleDir)\bin\Win64_Shipping_Client</BannerlordBinaryDir>
    <BannerlordGameBinaryDir>$(BannerlordInstallDir)\bin\Win64_Shipping_Client</BannerlordGameBinaryDir>
  </PropertyGroup>

  <!-- ─── Our SDK ───────────────────────────────────────────────────────── -->

  <ItemGroup>
    <ProjectReference Include="..\..\LLM Roleplay Service\NpcMemoryService.Core\NpcMemoryService.Core.csproj">
      <Private>true</Private>
    </ProjectReference>
    <!-- Pure, engine-agnostic mod logic (unit-tested separately). -->
    <ProjectReference Include="..\CalradiaRemembers.Logic\CalradiaRemembers.Logic.csproj">
      <Private>true</Private>
    </ProjectReference>
  </ItemGroup>

  <!-- ─── TaleWorlds DLLs (referenced from the game install) ────────────── -->

  <ItemGroup>
    <!-- GDI+ decode for the chat-portrait channel fix: the engine's CreateFromMemory reads red/blue swapped,
         so we decode, swap, and re-encode the image ourselves before handing it over. -->
    <Reference Include="System.Drawing" />
    <!-- CR's own video (.crvid, a zip of JPEG frames): read with the framework's own zip classes (11/10/2026). -->
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.Net.Http" />
    <!-- TaleWorlds.Library.Vec2 exposes System.Numerics.Vector2 in its public API, so this assembly
         must be referenced explicitly for any file using Vec2 to compile cleanly. The game ships a copy. -->
    <Reference Include="System.Numerics.Vectors">
      <HintPath>$(BannerlordGameBinaryDir)\System.Numerics.Vectors.dll</HintPath>
      <Private>false</Private>
      <!-- Aliased so a file needing the GAME's Vector2 identity (a Harmony patch on an engine method) can
           name it without colliding with the framework's System.Numerics copy of the same type. -->
      <Aliases>global,GameNumerics</Aliases>
    </Reference>
    <Reference Include="TaleWorlds.CampaignSystem">
      <HintPath>$(BannerlordGameBinaryDir)\TaleWorlds.CampaignSystem.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="TaleWorlds.Core">
      <HintPath>$(BannerlordGameBinaryDir)\TaleWorlds.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="TaleWorlds.Core.ViewModelCollection">
      <HintPath>$(BannerlordGameBinaryDir)\TaleWorlds.Core.ViewModelCollection.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="TaleWorlds.MountAndBlade.ViewModelCollection">
      <HintPath>$(BannerlordGameBinaryDir)\TaleWorlds.MountAndBlade.ViewModelCollection.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="TaleWorlds.CampaignSystem.ViewModelCollection">
      <HintPath>$(BannerlordGameBinaryDir)\TaleWorlds.CampaignSystem.ViewModelCollection.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(BannerlordModulesDir)\Bannerlord.Harmony\bin\Win64_Shipping_Client\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Bannerlord.UIExtenderEx">
      <HintPath>$(BannerlordModulesDir)\Bannerlord.UIExtenderEx\bin\Win64_Shipping_Client\Bannerlord.UIExtenderEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="MCMv5">
      <HintPath>$(BannerlordModulesDir)\Bannerlord.MBOptionScreen\bin\Win64_Shipping_Client\MCMv5.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="TaleWorlds.Engine.GauntletUI">
      <HintPath>$(BannerlordGameBinaryDir)\TaleWorlds.Engine.GauntletUI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="TaleWorlds.GauntletUI">
      <HintPath>$(BannerlordGameBinaryDir)\TaleWorlds.GauntletUI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="TaleWorlds.GauntletUI.Data">
      <HintPath>$(BannerlordGameBinaryDir)\TaleWorlds.GauntletUI.Data.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="TaleWorlds.GauntletUI.PrefabSystem">
      <HintPath>$(BannerlordGameBinaryDir)\TaleWorlds.GauntletUI.PrefabSystem.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="TaleWorlds.InputSystem">
      <HintPath>$(BannerlordGameBinaryDir)\TaleWorlds.InputSystem.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="TaleWorlds.TwoDimension">
      <HintPath>$(BannerlordGameBinaryDir)\TaleWorlds.TwoDimension.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="TaleWorlds.Library">
      <HintPath>$(BannerlordGameBinaryDir)\TaleWorlds.Library.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="TaleWorlds.Localization">
      <HintPath>$(BannerlordGameBinaryDir)\TaleWorlds.Localization.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="TaleWorlds.ModuleManager">
      <HintPath>$(BannerlordGameBinaryDir)\TaleWorlds.ModuleManager.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="TaleWorlds.DotNet">
      <HintPath>$(BannerlordGameBinaryDir)\TaleWorlds.DotNet.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="TaleWorlds.MountAndBlade">
      <HintPath>$(BannerlordGameBinaryDir)\TaleWorlds.MountAndBlade.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="TaleWorlds.MountAndBlade.View">
      <HintPath>$(BannerlordModulesDir)\Native\bin\Win64_Shipping_Client\TaleWorlds.MountAndBlade.View.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SandBox">
      <HintPath>$(BannerlordModulesDir)\SandBox\bin\Win64_Shipping_Client\SandBox.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SandBox.GauntletUI">
      <HintPath>$(BannerlordModulesDir)\SandBox\bin\Win64_Shipping_Client\SandBox.GauntletUI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="TaleWorlds.ObjectSystem">
      <HintPath>$(BannerlordGameBinaryDir)\TaleWorlds.ObjectSystem.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="TaleWorlds.SaveSystem">
      <HintPath>$(BannerlordGameBinaryDir)\TaleWorlds.SaveSystem.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="TaleWorlds.Engine">
      <HintPath>$(BannerlordGameBinaryDir)\TaleWorlds.Engine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(BannerlordGameBinaryDir)\Newtonsoft.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="TaleWorlds.ScreenSystem">
      <HintPath>$(BannerlordGameBinaryDir)\TaleWorlds.ScreenSystem.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!--
    ─── Auto-deploy to the Bannerlord module after build (single target) ────
    Deploys ONLY the mod's own assemblies plus module content (SubModule.xml,
    GUI prefabs, ModuleData, Sounds). Everything else (TaleWorlds.*, Newtonsoft.Json)
    is already provided by the game; bundling it is redundant and risks version
    drift. No .pdb either — players don't need debug symbols.
    NpcMemoryService.Core uses Newtonsoft.Json (shipped by Bannerlord, 13.0.1) —
    the old System.Text.Json facade tree (which caused assembly-load failures on
    some players' machines) is gone.
  -->
  <!-- Skip the game deploy under NCrunch (and any build with no game install): NCrunch builds the
       project in an isolated workspace where ..\SubModule.xml and the Bannerlord paths do not exist. -->
  <Target Name="DeployToBannerlord" AfterTargets="Build"
          Condition="'$(NCrunch)' != '1' And Exists('$(BannerlordGameBinaryDir)')">
    <ItemGroup>
      <ModAssemblies   Include="$(TargetDir)CalradiaRemembers.dll;$(TargetDir)CalradiaRemembers.Logic.dll;$(TargetDir)NpcMemoryService.Core.dll" />
      <GuiPrefabFiles  Include="$(ProjectDir)GUI\Prefabs\*.xml" />
      <GuiBrushFiles   Include="$(ProjectDir)GUI\Brushes\*.xml" />
      <!-- UI art (the style button's quill). Without this the image ships in the repo but never reaches the
           game, and the header silently falls back to its text button. -->
      <GuiImageFiles   Include="$(ProjectDir)GUI\Images\*.*" />
      <!-- Recursive: ModuleData has SUBFOLDERS (Styles, scenarios) and the old flat glob silently left them
           behind, so a shipped style file never reached the game. Mirrors the Sounds pattern below. -->
      <ModuleDataFiles Include="$(ProjectDir)ModuleData\**\*.*" />
      <SoundFiles      Include="$(ProjectDir)Sounds\**\*.*" />
      <!-- The modder guides. The Nexus page and the changelogs said they "ship with the mod" for months while
           nothing copied them (found cutting 2.5.23): a bridge author had no way to read them but the repo. -->
      <ModderGuideFiles Include="$(ProjectDir)Extension\HOWTO_*.md;$(ProjectDir)Extension\TaleEditor.html;$(ProjectDir)Extension\ScenarioComposer.html;$(ProjectDir)..\EXTENSION_API.md" />
    </ItemGroup>

    <MakeDir Directories="$(BannerlordBinaryDir)" />
    <!-- Assemblies keep SkipUnchangedFiles: a recompile always changes their size/timestamp so the check is
         reliable, and skipping an UNCHANGED dll avoids a build failure when the game holds it locked. -->
    <Copy SourceFiles="@(ModAssemblies)"            DestinationFolder="$(BannerlordBinaryDir)"             SkipUnchangedFiles="true" />
    <!-- Content files are FORCE-copied (SkipUnchangedFiles=false). MSBuild's up-to-date check compares only
         size + timestamp, never content, so a same-size text edit (e.g. bumping SubModule.xml from v2.4.0 to
         v2.4.3, an identical byte length) was judged "unchanged" and skipped, leaving a stale version label
         deployed while the dlls updated. These files are small and never locked by the running game, so a
         forced overwrite every build is cheap and keeps the module folder truthful. OverwriteReadOnlyFiles
         guards against OneDrive marking a synced file read-only. Copy never deletes extras, so a player's own
         deployed ModuleData\character_overrides.json (absent from the repo) is left untouched. -->
    <Copy SourceFiles="$(ProjectDir)..\SubModule.xml" DestinationFolder="$(BannerlordModuleDir)"           SkipUnchangedFiles="false" OverwriteReadOnlyFiles="true" />
    <Copy SourceFiles="@(GuiPrefabFiles)"           DestinationFolder="$(BannerlordModuleDir)\GUI\Prefabs" SkipUnchangedFiles="false" OverwriteReadOnlyFiles="true" />
    <Copy SourceFiles="@(GuiBrushFiles)"            DestinationFolder="$(BannerlordModuleDir)\GUI\Brushes" SkipUnchangedFiles="false" OverwriteReadOnlyFiles="true" />
    <Copy SourceFiles="@(GuiImageFiles)"            DestinationFolder="$(BannerlordModuleDir)\GUI\Images"  SkipUnchangedFiles="false" OverwriteReadOnlyFiles="true" />
    <Copy SourceFiles="@(ModuleDataFiles)"          DestinationFolder="$(BannerlordModuleDir)\ModuleData\%(RecursiveDir)" SkipUnchangedFiles="false" OverwriteReadOnlyFiles="true" />
    <Copy SourceFiles="@(SoundFiles)"               DestinationFolder="$(BannerlordModuleDir)\Sounds\%(RecursiveDir)" SkipUnchangedFiles="false" OverwriteReadOnlyFiles="true" />
    <Copy SourceFiles="@(ModderGuideFiles)"         DestinationFolder="$(BannerlordModuleDir)\Docs"       SkipUnchangedFiles="false" OverwriteReadOnlyFiles="true" />

    <ReadLinesFromFile File="$(ProjectDir)..\SubModule.xml">
      <Output TaskParameter="Lines" ItemName="SubModuleXmlLine" />
    </ReadLinesFromFile>
    <Message Text="[CalradiaRemembers] Deployed to $(BannerlordModuleDir)  (%(SubModuleXmlLine.Identity))"
             Importance="high" Condition="$([System.String]::Copy('%(SubModuleXmlLine.Identity)').Contains('Version value'))" />
  </Target>

</Project>
