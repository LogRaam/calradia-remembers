// character_overrides.json: hand-authored personalities for Calradia Remembers.
//
// Enable in Mod Options -> Calradia Remembers -> Character -> "Use custom traits".
// When on, each entry below REPLACES that NPC's five vanilla personality traits, so the prompt's
// derived persona, the trait-derived features (kinks, and so on), and the campaign AI all read your
// values. Turning the toggle off restores the vanilla traits.
//
// HOW TO ADD A CHARACTER:
//   1. Remove the // from each line of the example block inside the [ ] brackets below.
//   2. Edit the values to taste, keeping the block between the [ ] brackets.
//   3. For more than one character, separate each { } block with a comma.
//   4. Save, then run cr.reload_lore from the console (Alt and ~), or reload your save.
//
// FIELDS (per entry):
//   "hero"        display name to match (case-insensitive)
//   "id"          OPTIONAL StringId, to tell apart two NPCs who share a name
//   "valor", "honor", "mercy", "generosity", "calculating"   each -2..+2; omit one to keep its vanilla value
//   "backstory"   OPTIONAL free text (roleplay flavour only: colour, not behaviour; conduct still follows traits)
//
[
  // {
  //   "hero": "Derthert",
  //   "valor": 1,
  //   "honor": -1,
  //   "calculating": 2,
  //   "backstory": "A Vlandian king who trusts ledgers more than men, and remembers every debt."
  // }
]
