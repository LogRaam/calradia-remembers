<Prefab>
  <!--
    Bespoke COUNCIL window. A THIRD skin bound to the SAME ChatViewModel as Classic and Manuscript, selected only
    for a council/assembly session (ChatManager.CouncilSkin).

    2026-08-23: rebuilt onto Gabriel's full-book leather art (GUI/Images/cr_counsel.jpg, 1683x935). Like the
    Manuscript skin this is now a FIXED-ASPECT book (not the old stretch layout): a fixed-size BookRoot holds the
    painted background, and every control is laid over the slots the art already paints (the "YOUR COUNCIL" strip,
    the centre panel with its title banner + input bar + red End button, the "ENGAGEMENTS" strip). ChatManager
    scales the whole council layer (UIContext.ScaleModifier = CouncilZoom) so the book and every overlay stay
    aligned and fill the same fraction of the screen at any resolution, exactly as Manuscript does.

    HEADER (Gabriel's design): the small pennant on the banner shows the SEAT COUNT (@CouncilSeatCountText); the
    banner title names the mod and WHERE the sitting is held (@CouncilTitleText, "Calradia Remembers, Valek
    Castle"); the line under it names the KIND of gathering (@CouncilAgendaText, "Council of companions").

    POSITIONS ARE ESTIMATES from the art, to tune in-game with cr.reload_ui (hot-reloads this prefab from the
    DEPLOYED module folder). The End-conversation button is BAKED into the art, so a transparent hit-box sits over
    it; it currently carries a visible tint for positioning (make its Color #FFFFFF00 once placed).

    The dossier overlay (a seat clicked in the left strip) reuses the exact Panel* bindings the Manuscript left
    page / Classic portrait pop-out use, gated on IsCouncilDossierOpen.
  -->
  <Constants>
    <Constant Name="Council.Book.Width"  Value="1683" />
    <Constant Name="Council.Book.Height" Value="935" />
  </Constants>

  <Window Id="CalradiaRemembersChatWindow" Layer="Overlay">

    <Widget Id="ScreenRoot"
            WidthSizePolicy="StretchToParent"
            HeightSizePolicy="StretchToParent">
      <Children>

        <!-- OPAQUE backdrop (Gabriel 2026-08-02). The council is hosted over a staged CONVERSATION mission so the
             map is suspended, but there is no presiding NPC to show: a full-opaque fill hides that scene in the
             margins the fixed-aspect book leaves on the sides. Carries ChatVisualOffsetX so it slides aside with
             the book when the focus-arbiter yields to another screen. -->
        <Widget Id="CouncilBackdrop"
                WidthSizePolicy="StretchToParent"
                HeightSizePolicy="StretchToParent"
                Sprite="BlankWhiteSquare_9"
                Color="#0d0a08FF"
                PositionXOffset="@ChatVisualOffsetX" />

        <!-- The book: fixed size (aspect-locked to cr_counsel.jpg). Centred; ChatManager's CouncilZoom scales the
             whole layer to fit. PositionXOffset keeps the focus-arbiter slide-aside (SetVisualOffscreen) working. -->
        <Widget Id="CouncilBookRoot"
                WidthSizePolicy="Fixed"
                HeightSizePolicy="Fixed"
                SuggestedWidth="!Council.Book.Width"
                SuggestedHeight="!Council.Book.Height"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                PositionXOffset="@ChatVisualOffsetX">
          <Children>

            <!-- Painted leather book: left strip, centre panel, right strip, all baked. CorrectRedBlue=true (JPG
                 reads with red/blue swapped in game, like the chat page art). -->
            <CrRuntimeImageWidget Id="CouncilBg"
                                  WidthSizePolicy="StretchToParent"
                                  HeightSizePolicy="StretchToParent"
                                  ImagePath="@CouncilBackgroundPath"
                                  CorrectRedBlue="true"
                                  IsDisabled="true" />

            <!-- ============================ HEADER (on the centre banner) ============================ -->

            <!-- Seat count, in the small pennant at the banner's left. -->
            <TextWidget Id="CouncilSeatCountWidget"
                        WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                        SuggestedWidth="64" SuggestedHeight="52"
                        HorizontalAlignment="Left" VerticalAlignment="Top"
                        MarginLeft="353" MarginTop="30"
                        Brush="Default" Brush.FontSize="30" Brush.FontColor="#d8b878FF"
                        Brush.TextHorizontalAlignment="Center" Text="@CouncilSeatCountText" IsDisabled="true" />

            <!-- Title: mod name + place, centred over the centre panel (the book centre ~= the panel centre). -->
            <TextWidget Id="CouncilTitleWidget"
                        WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                        SuggestedWidth="900" SuggestedHeight="44"
                        HorizontalAlignment="Center" VerticalAlignment="Top" MarginTop="30"
                        Brush="Default" Brush.FontSize="32" Brush.FontColor="#d8b878FF"
                        Brush.TextHorizontalAlignment="Center" Text="@CouncilTitleText" IsDisabled="true" />

            <!-- Kind of gathering, under the title. -->
            <TextWidget Id="CouncilAgendaTextWidget"
                        WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                        SuggestedWidth="900" SuggestedHeight="26"
                        HorizontalAlignment="Center" VerticalAlignment="Top" MarginTop="75"
                        Brush="Default" Brush.FontSize="18" Brush.FontColor="#b8a888FF"
                        Brush.TextHorizontalAlignment="Center" Text="@CouncilAgendaText" IsDisabled="true" />

            <!-- ============================ LEFT: seated roster ============================ -->
            <Widget Id="LeftListArea"
                    WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                    SuggestedWidth="267" SuggestedHeight="750"
                    HorizontalAlignment="Left" VerticalAlignment="Top"
                    MarginLeft="42" MarginTop="112">
              <Children>

                <PortraitScrollablePanel Id="CouncilParticipantsScroll"
                                         WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                         MarginRight="14" AutoHideScrollBars="true"
                                         ClipRect="CouncilParticipantsClip"
                                         InnerPanel="CouncilParticipantsClip\CouncilParticipantsList"
                                         VerticalScrollbar="..\CouncilParticipantsScrollbar\Scrollbar">
                  <Children>
                    <Widget Id="CouncilParticipantsClip"
                            WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                            ClipContents="true">
                      <Children>

                        <NavigatableListPanel Id="CouncilParticipantsList"
                                              DataSource="{CouncilParticipants}"
                                              WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren"
                                              HorizontalAlignment="Left" VerticalAlignment="Top"
                                              StackLayout.LayoutMethod="VerticalTopToBottom">
                          <ItemTemplate>

                            <ButtonWidget Id="ParticipantTile"
                                          WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed"
                                          SuggestedHeight="124"
                                          MarginBottom="8"
                                          DoNotPassEventsToChildren="true"
                                          Command.Click="ExecuteOpenDossier">
                              <Children>

                                <Widget Id="ParticipantHighlight"
                                        WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                        IsVisible="@IsActiveSpeaker"
                                        Sprite="frame_9"
                                        ExtendLeft="4" ExtendTop="4" ExtendRight="4" ExtendBottom="4"
                                        Color="#D9A441FF" AlphaFactor="0.8" IsDisabled="true" />

                                <ImageIdentifierWidget Id="ParticipantVanillaPortrait"
                                                       WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                                                       SuggestedWidth="@PortraitWidth" SuggestedHeight="@PortraitHeight"
                                                       HorizontalAlignment="Center" VerticalAlignment="Top"
                                                       MarginTop="8"
                                                       IsVisible="@ShowVanillaPortrait"
                                                       TextureProviderName="@PortraitTextureProviderName"
                                                       ImageId="@PortraitId"
                                                       AdditionalArgs="@PortraitAdditionalArgs"
                                                       IsBig="true" HideWhenNull="false" IsDisabled="true" />

                                <CrRuntimeImageWidget Id="ParticipantCustomPortrait"
                                                      WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                                                      SuggestedWidth="@PortraitWidth" SuggestedHeight="@PortraitHeight"
                                                      HorizontalAlignment="Center" VerticalAlignment="Top"
                                                      MarginTop="8"
                                                      IsVisible="@ShowCustomPortrait"
                                                      ImagePath="@PlayerPortraitPath" IsDisabled="true" />

                                <TextWidget Id="ParticipantName"
                                            WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed"
                                            SuggestedHeight="20"
                                            HorizontalAlignment="Center" VerticalAlignment="Top"
                                            MarginTop="74" MarginLeft="6" MarginRight="6"
                                            Brush="Default" Brush.FontSize="15" Brush.FontColor="#e8d8b8FF"
                                            Brush.TextHorizontalAlignment="Center" Text="@Name" IsDisabled="true" />

                                <TextWidget Id="ParticipantSeatLabel"
                                            WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren"
                                            HorizontalAlignment="Center" VerticalAlignment="Top"
                                            MarginTop="96" MarginLeft="6" MarginRight="6"
                                            Brush="Default" Brush.FontSize="12" Brush.FontColor="#9a8a78FF"
                                            Brush.TextHorizontalAlignment="Center" Text="@SeatLabel" IsDisabled="true" />

                              </Children>
                            </ButtonWidget>

                          </ItemTemplate>
                        </NavigatableListPanel>

                      </Children>
                    </Widget>
                  </Children>
                </PortraitScrollablePanel>

                <Standard.VerticalScrollbar Id="CouncilParticipantsScrollbar"
                                            HeightSizePolicy="StretchToParent"
                                            HorizontalAlignment="Right" MarginRight="0" />

              </Children>
            </Widget>

            <!-- ============================ CENTER: the conversation ============================ -->

            <!-- Message list, over the centre panel. -->
            <Widget Id="MessagesArea"
                    WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                    VerticalAlignment="Top"
                    MarginTop="150" MarginBottom="150"
                    MarginLeft="352" MarginRight="335">
              <Children>

                <ChatScrollablePanel Id="MessagesScrollPanel"
                                     WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                     MarginRight="28" AutoHideScrollBars="true"
                                     ClipRect="MessagesClipRect"
                                     InnerPanel="MessagesClipRect\MessagesList"
                                     VerticalScrollbar="..\MessagesScrollbar\Scrollbar">
                  <Children>
                    <Widget Id="MessagesClipRect"
                            WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                            ClipContents="true">
                      <Children>

                        <NavigatableListPanel Id="MessagesList"
                                              DataSource="{Messages}"
                                              WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren"
                                              HorizontalAlignment="Left" VerticalAlignment="Top"
                                              StackLayout.LayoutMethod="VerticalTopToBottom">
                          <ItemTemplate>

                            <Widget Id="MessageRow"
                                    WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren"
                                    HorizontalAlignment="Left"
                                    MarginLeft="20" MarginTop="12" MarginBottom="2">
                              <Children>

                                <ButtonWidget Id="AvatarContainer"
                                        Command.Click="ExecuteShowPortrait"
                                        WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                                        SuggestedWidth="@AvatarWidth" SuggestedHeight="@AvatarHeight"
                                        HorizontalAlignment="Left" VerticalAlignment="Top"
                                        MarginTop="2"
                                        IsVisible="@ShowAvatar"
                                        Command.AlternateClick="ExecuteOpenEncyclopedia">
                                  <Children>

                                    <ImageIdentifierWidget Id="AvatarPortrait"
                                                           WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                                                           SuggestedWidth="88" SuggestedHeight="44"
                                                           HorizontalAlignment="Center" VerticalAlignment="Top"
                                                           IsVisible="@ShowVanillaPortrait"
                                                           TextureProviderName="@PortraitTextureProviderName"
                                                           ImageId="@PortraitId"
                                                           AdditionalArgs="@PortraitAdditionalArgs"
                                                           IsBig="true" HideWhenNull="false" IsDisabled="true" />

                                    <CrRuntimeImageWidget Id="CustomAvatar"
                                                          WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                                          IsVisible="@ShowCustomPortrait"
                                                          ImagePath="@PlayerPortraitPath" IsDisabled="true" />

                                    <Widget Id="AvatarFrame"
                                            WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                            IsVisible="@ShowVanillaPortrait"
                                            Sprite="frame_9"
                                            ExtendLeft="15" ExtendTop="22" ExtendRight="15" ExtendBottom="-22"
                                            AlphaFactor="0.25" IsDisabled="true" />
                                  </Children>
                                </ButtonWidget>

                                <RichTextWidget Id="MessageText"
                                                WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren"
                                                HorizontalAlignment="Left" VerticalAlignment="Top"
                                                MarginLeft="@TextMarginLeft" MarginRight="14"
                                                Brush="@CouncilMessageFontBrush" Brush.FontColor="@AuthorColor"
                                                Brush.TextHorizontalAlignment="Left"
                                                Text="@DisplayText" IsDisabled="true" />

                              </Children>
                            </Widget>

                          </ItemTemplate>
                        </NavigatableListPanel>

                      </Children>
                    </Widget>
                  </Children>
                </ChatScrollablePanel>

                <Standard.VerticalScrollbar Id="MessagesScrollbar"
                                            HeightSizePolicy="StretchToParent"
                                            HorizontalAlignment="Right" MarginRight="0" />

              </Children>
            </Widget>

            <!-- Input row, over the baked input bar (to the right of the painted chat-bubble icon). Enter sends;
                 no visible fill, the art paints the bar. -->
            <Widget Id="InputArea"
                    WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed"
                    SuggestedHeight="52"
                    VerticalAlignment="Bottom" MarginBottom="60"
                    MarginLeft="412" MarginRight="356">
              <Children>
                <Widget Id="InputBox"
                        WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                        IsVisible="@IsChatInputVisible">
                  <Children>
                    <ChatInputWidget Id="MessageInput"
                                     WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                     HorizontalAlignment="Left" VerticalAlignment="Center"
                                     MarginLeft="8" MarginRight="8" MarginTop="6" MarginBottom="6"
                                     Brush="Default" Brush.FontSize="19" Brush.FontColor="#e8d8b8FF"
                                     Brush.TextHorizontalAlignment="Left" MaxLength="8000" Text="@InputText" />
                  </Children>
                </Widget>
              </Children>
            </Widget>

            <!-- End conversation: the button is BAKED into the art; this is the invisible hit-box over it.
                 TINTED for positioning (Gabriel): set Color to #FFFFFF00 once it sits over the painted button. -->
            <ButtonWidget Id="EndCouncilButton"
                          WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                          SuggestedWidth="195" SuggestedHeight="33"
                          HorizontalAlignment="Center" VerticalAlignment="Bottom" MarginBottom="23" MarginLeft="10"
                          DoNotPassEventsToChildren="true"
                          UpdateChildrenStates="true" Command.Click="ExecuteClose">
              <Children>
                <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                        Sprite="BlankWhiteSquare_9" Color="#33cc3300" IsDisabled="true" />
              </Children>
            </ButtonWidget>

            <!-- ============================ RIGHT: Engagements ============================ -->

            <TextWidget Id="EngagementsPlaceholder"
                        WidthSizePolicy="Fixed" HeightSizePolicy="CoverChildren"
                        SuggestedWidth="240"
                        HorizontalAlignment="Right" VerticalAlignment="Top" MarginTop="130" MarginRight="40"
                        IsVisible="@ShowEngagementsPlaceholder"
                        Brush="Default" Brush.FontSize="15" Brush.FontColor="#9a8a78FF"
                        Brush.TextHorizontalAlignment="Center" Text="@EngagementsPlaceholderText" IsDisabled="true" />

            <Widget Id="RightListArea"
                    WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                    SuggestedWidth="250" SuggestedHeight="512"
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    MarginRight="35" MarginTop="112"
                    IsVisible="@HasEngagements">
              <Children>

                <PortraitScrollablePanel Id="EngagementsScroll"
                                         WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                         MarginRight="14" AutoHideScrollBars="true"
                                         ClipRect="EngagementsClip"
                                         InnerPanel="EngagementsClip\EngagementsList"
                                         VerticalScrollbar="..\EngagementsScrollbar\Scrollbar">
                  <Children>
                    <Widget Id="EngagementsClip"
                            WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                            ClipContents="true">
                      <Children>

                        <NavigatableListPanel Id="EngagementsList"
                                              DataSource="{Engagements}"
                                              WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren"
                                              HorizontalAlignment="Left" VerticalAlignment="Top"
                                              StackLayout.LayoutMethod="VerticalTopToBottom">
                          <ItemTemplate>
                            <ListPanel Id="EngagementRow"
                                       WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren"
                                       HorizontalAlignment="Left" MarginTop="8" MarginBottom="8"
                                       MarginLeft="4" MarginRight="4"
                                       StackLayout.LayoutMethod="VerticalTopToBottom">
                              <Children>
                                <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren"
                                            HorizontalAlignment="Left"
                                            Brush="Default" Brush.FontSize="14" Brush.FontColor="#c8a878FF"
                                            Brush.TextHorizontalAlignment="Left" Text="@Label" IsDisabled="true" />
                                <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren"
                                            HorizontalAlignment="Left" MarginTop="2"
                                            Brush="Default" Brush.FontSize="13" Brush.FontColor="#e8d8b8FF"
                                            Brush.TextHorizontalAlignment="Left" Text="@Detail" IsDisabled="true" />
                                <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren"
                                            HorizontalAlignment="Left" MarginTop="2"
                                            Brush="Default" Brush.FontSize="12" Brush.FontColor="#9a8a78FF"
                                            Brush.TextHorizontalAlignment="Left" Text="@Status" IsDisabled="true" />
                              </Children>
                            </ListPanel>
                          </ItemTemplate>
                        </NavigatableListPanel>

                      </Children>
                    </Widget>
                  </Children>
                </PortraitScrollablePanel>

                <Standard.VerticalScrollbar Id="EngagementsScrollbar"
                                            HeightSizePolicy="StretchToParent"
                                            HorizontalAlignment="Right" MarginRight="0" />

              </Children>
            </Widget>

          </Children>
        </Widget>

        <!-- ============================ Dossier overlay ============================ -->
        <!-- Reuses the SAME Panel* bindings as the Manuscript left page / Classic portrait pop-out, gated on
             IsCouncilDossierOpen. Scales with the layer (ChatManager's CouncilZoom) like everything else. -->
        <Widget Id="CouncilDossierOverlay"
                WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                SuggestedWidth="620" SuggestedHeight="760"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                IsVisible="@IsCouncilDossierOpen"
                Sprite="BlankWhiteSquare_9" Color="#1a1612F5">
          <Children>

            <Widget Id="CouncilDossierFrame"
                    WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                    Sprite="frame_9" ExtendLeft="8" ExtendTop="8" ExtendRight="8" ExtendBottom="8"
                    AlphaFactor="0.4" IsDisabled="true" />

            <TextWidget Id="CouncilDossierTitle"
                        WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="40"
                        HorizontalAlignment="Center" VerticalAlignment="Top" MarginTop="20"
                        Brush="Default" Brush.FontSize="24" Brush.FontColor="#c8a878FF"
                        Brush.TextHorizontalAlignment="Center" Text="@PortraitPanelTitle" IsDisabled="true" />

            <Widget Id="CouncilDossierPortraitArea"
                    WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                    SuggestedWidth="230" SuggestedHeight="272"
                    HorizontalAlignment="Center" VerticalAlignment="Top" MarginTop="70"
                    ClipContents="true">
              <Children>
                <CrRuntimeImageWidget Id="CouncilDossierCustomPortrait"
                                      WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                                      SuggestedWidth="@ManuscriptPortraitWidth"
                                      SuggestedHeight="@ManuscriptPortraitHeight"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      IsVisible="@ShowPanelCustomPortrait"
                                      ImagePath="@PanelPortraitPath" IsDisabled="true" />
                <ImageIdentifierWidget Id="CouncilDossierVanillaPortrait"
                                       WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                                       SuggestedWidth="@ManuscriptPortraitWidth"
                                       SuggestedHeight="@ManuscriptPortraitHeight"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       IsVisible="@ShowPanelVanillaPortrait"
                                       TextureProviderName="@PanelPortraitTextureProviderName"
                                       ImageId="@PanelPortraitId"
                                       AdditionalArgs="@PanelPortraitAdditionalArgs"
                                       IsBig="true" HideWhenNull="false" IsDisabled="true" />
              </Children>
            </Widget>

            <Widget Id="CouncilDossierTextArea"
                    WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                    VerticalAlignment="Top" MarginTop="360" MarginBottom="70" MarginLeft="30" MarginRight="30">
              <Children>
                <PortraitScrollablePanel Id="CouncilDossierScroll"
                                         WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                         MarginRight="20" AutoHideScrollBars="true"
                                         ClipRect="CouncilDossierClip"
                                         InnerPanel="CouncilDossierClip\CouncilDossierList"
                                         VerticalScrollbar="..\CouncilDossierScrollbar\Scrollbar">
                  <Children>
                    <Widget Id="CouncilDossierClip"
                            WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                            ClipContents="true">
                      <Children>
                        <ListPanel Id="CouncilDossierList"
                                   WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren"
                                   HorizontalAlignment="Left" VerticalAlignment="Top"
                                   MarginLeft="4" MarginRight="6"
                                   StackLayout.LayoutMethod="VerticalTopToBottom">
                          <Children>

                            <RichTextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren"
                                            Brush="Encyclopedia.Stat.ValueText" Brush.FontSize="16"
                                            Brush.TextHorizontalAlignment="Left"
                                            Text="@PanelInfoFacts" IsVisible="@ShowPanelInfo" IsDisabled="true" />

                            <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="26"
                                        MarginTop="14" Brush="Encyclopedia.Stat.DefinitionText" Brush.FontSize="18"
                                        Brush.TextHorizontalAlignment="Left" Text="Background"
                                        IsVisible="@ShowPanelBackground" IsDisabled="true" />
                            <RichTextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren"
                                            MarginTop="2" Brush="Default" Brush.FontSize="15" Brush.FontColor="#d8c8a8FF"
                                            Brush.TextHorizontalAlignment="Left"
                                            Text="@PanelBackground" IsVisible="@ShowPanelBackground" IsDisabled="true" />

                            <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="26"
                                        MarginTop="14" Brush="Encyclopedia.Stat.DefinitionText" Brush.FontSize="18"
                                        Brush.TextHorizontalAlignment="Left" Text="Character"
                                        IsVisible="@ShowPanelCharacter" IsDisabled="true" />
                            <RichTextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren"
                                            MarginTop="2" Brush="Default" Brush.FontSize="15" Brush.FontColor="#d8c8a8FF"
                                            Brush.TextHorizontalAlignment="Left"
                                            Text="@PanelCharacter" IsVisible="@ShowPanelCharacter" IsDisabled="true" />

                            <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="26"
                                        MarginTop="14" Brush="Encyclopedia.Stat.DefinitionText" Brush.FontSize="18"
                                        Brush.TextHorizontalAlignment="Left" Text="Appearance"
                                        IsVisible="@ShowPanelAppearance" IsDisabled="true" />
                            <RichTextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren"
                                            MarginTop="2" Brush="Default" Brush.FontSize="15" Brush.FontColor="#d8c8a8FF"
                                            Brush.TextHorizontalAlignment="Left"
                                            Text="@PanelAppearance" IsVisible="@ShowPanelAppearance" IsDisabled="true" />

                            <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="26"
                                        MarginTop="14" Brush="Encyclopedia.Stat.DefinitionText" Brush.FontSize="18"
                                        Brush.TextHorizontalAlignment="Left" Text="What you have learned"
                                        IsVisible="@ShowPanelDiscoveries" IsDisabled="true" />
                            <RichTextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren"
                                            MarginTop="2" Brush="Encyclopedia.Stat.ValueText" Brush.FontSize="15"
                                            Brush.TextHorizontalAlignment="Left"
                                            Text="@PanelInfoDiscoveries" IsVisible="@ShowPanelDiscoveries" IsDisabled="true" />

                            <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="26"
                                        MarginTop="14" Brush="Encyclopedia.Stat.DefinitionText" Brush.FontSize="18"
                                        Brush.TextHorizontalAlignment="Left" Text="Heart"
                                        IsVisible="@ShowPanelHeart" IsDisabled="true" />
                            <RichTextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren"
                                            MarginTop="2" Brush="Encyclopedia.Stat.ValueText" Brush.FontSize="15"
                                            Brush.TextHorizontalAlignment="Left"
                                            Text="@PanelHeart" IsVisible="@ShowPanelHeart" IsDisabled="true" />

                            <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="26"
                                        MarginTop="14" Brush="Encyclopedia.Stat.DefinitionText" Brush.FontSize="18"
                                        Brush.TextHorizontalAlignment="Left" Text="Kindnesses"
                                        IsVisible="@ShowPanelKindnesses" IsDisabled="true" />
                            <RichTextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren"
                                            MarginTop="2" Brush="Encyclopedia.Stat.ValueText" Brush.FontSize="15"
                                            Brush.TextHorizontalAlignment="Left"
                                            Text="@PanelKindnesses" IsVisible="@ShowPanelKindnesses" IsDisabled="true" />

                            <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="26"
                                        MarginTop="14" Brush="Encyclopedia.Stat.DefinitionText" Brush.FontSize="18"
                                        Brush.TextHorizontalAlignment="Left" Text="Grievances"
                                        IsVisible="@ShowPanelGrievances" IsDisabled="true" />
                            <RichTextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren"
                                            MarginTop="2" Brush="Encyclopedia.Stat.ValueText" Brush.FontSize="15"
                                            Brush.TextHorizontalAlignment="Left"
                                            Text="@PanelGrievances" IsVisible="@ShowPanelGrievances" IsDisabled="true" />

                            <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="26"
                                        MarginTop="14" Brush="Encyclopedia.Stat.DefinitionText" Brush.FontSize="18"
                                        Brush.TextHorizontalAlignment="Left" Text="Standing accords"
                                        IsVisible="@ShowPanelAccords" IsDisabled="true" />
                            <RichTextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren"
                                            MarginTop="2" Brush="Encyclopedia.Stat.ValueText" Brush.FontSize="15"
                                            Brush.TextHorizontalAlignment="Left"
                                            Text="@PanelAccords" IsVisible="@ShowPanelAccords" IsDisabled="true" />

                            <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="26"
                                        MarginTop="14" Brush="Encyclopedia.Stat.DefinitionText" Brush.FontSize="18"
                                        Brush.TextHorizontalAlignment="Left" Text="@PanelNemesisLabel"
                                        IsVisible="@ShowPanelNemesis" IsDisabled="true" />
                            <RichTextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren"
                                            MarginTop="2" Brush="Encyclopedia.Stat.ValueText" Brush.FontSize="15"
                                            Brush.TextHorizontalAlignment="Left"
                                            Text="@PanelNemesis" IsVisible="@ShowPanelNemesis" IsDisabled="true" />

                            <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="26"
                                        MarginTop="14" Brush="Encyclopedia.Stat.DefinitionText" Brush.FontSize="18"
                                        Brush.TextHorizontalAlignment="Left" Text="Trauma"
                                        IsVisible="@ShowPanelTrauma" IsDisabled="true" />
                            <RichTextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren"
                                            MarginTop="2" Brush="Encyclopedia.Stat.ValueText" Brush.FontSize="15"
                                            Brush.TextHorizontalAlignment="Left"
