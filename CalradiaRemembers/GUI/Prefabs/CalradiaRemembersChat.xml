<Prefab>
  <Constants>
    <Constant Name="Chat.Width"  Value="700" />
    <Constant Name="Avatar.Size" Value="55" />
  </Constants>

  <Window Id="CalradiaRemembersChatWindow" Layer="Overlay">

    <!-- Full-screen root so BOTH the chat panel (right) and the optional composer (left) are laid out. A Window
         only measures a single main child, so a second sibling panel would render at zero size / not at all. -->
    <Widget Id="ScreenRoot"
            WidthSizePolicy="StretchToParent"
            HeightSizePolicy="StretchToParent">
      <Children>

    <Widget Id="ChatPanel"
            WidthSizePolicy="Fixed"
            HeightSizePolicy="StretchToParent"
            SuggestedWidth="!Chat.Width"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            MarginTop="100"
            MarginBottom="100"
            PositionXOffset="-30"
            Sprite="BlankWhiteSquare_9"
            Color="#1a1612F2">

      <Children>

        <Widget Id="ChatPanelDecorativeFrame"
                WidthSizePolicy="StretchToParent"
                HeightSizePolicy="StretchToParent"
                Sprite="frame_9"
                ExtendLeft="8" ExtendTop="8" ExtendRight="8" ExtendBottom="8"
                AlphaFactor="0.4"
                IsDisabled="true" />

        <Widget Id="TitleBar"
                WidthSizePolicy="StretchToParent"
                HeightSizePolicy="Fixed"
                SuggestedHeight="95"
                VerticalAlignment="Top"
                Sprite="BlankWhiteSquare_9"
                Color="#0d0a08FF">
          <Children>
            <TextWidget Id="TitleTextWidget"
                        WidthSizePolicy="StretchToParent"
                        HeightSizePolicy="Fixed"
                        SuggestedHeight="40"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        MarginTop="6"
                        Brush="Default"
                        Brush.FontSize="24"
                        Brush.FontColor="#c8a878FF"
                        Brush.TextHorizontalAlignment="Center"
                        Text="@TitleText"
                        IsDisabled="true" />
            <TextWidget Id="WitnessesTextWidget"
                        WidthSizePolicy="StretchToParent"
                        HeightSizePolicy="Fixed"
                        SuggestedHeight="20"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        MarginTop="47"
                        IsVisible="@HasWitnesses"
                        Brush="Default"
                        Brush.FontSize="14"
                        Brush.FontColor="#7a9070FF"
                        Brush.TextHorizontalAlignment="Center"
                        Text="@WitnessesText"
                        IsDisabled="true" />
            <TextWidget Id="RelationSummaryWidget"
                        WidthSizePolicy="StretchToParent"
                        HeightSizePolicy="Fixed"
                        SuggestedHeight="22"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        MarginBottom="6"
                        Brush="Default"
                        Brush.FontSize="16"
                        Brush.FontColor="#9a8a78FF"
                        Brush.TextHorizontalAlignment="Center"
                        Text="@RelationSummary"
                        IsDisabled="true" />
            <ButtonWidget Id="RequestPrivateButton"
                          WidthSizePolicy="Fixed"
                          HeightSizePolicy="Fixed"
                          SuggestedWidth="130"
                          SuggestedHeight="22"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Bottom"
                          MarginBottom="6"
                          MarginRight="10"
                          IsVisible="@IsPrivateRequestVisible"
                          DoNotPassEventsToChildren="true"
                          Brush="ButtonBrush1"
                          UpdateChildrenStates="true"
                          Command.Click="ExecuteRequestPrivate">
              <Children>
                <TextWidget WidthSizePolicy="StretchToParent"
                            HeightSizePolicy="StretchToParent"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Brush="Popup.Button.Text"
                            Brush.FontSize="14"
                            Text="Request Private" />
              </Children>
            </ButtonWidget>
            <!-- Model mode toggle: shows which of the two configured models is active
                 (roleplay/NSFW) and flips it on click. Deliberately muted: a utility
                 control, not a story beat. Visible only when an NSFW model is set. -->
            <ButtonWidget Id="ModelModeButton"
                          WidthSizePolicy="Fixed"
                          HeightSizePolicy="Fixed"
                          SuggestedWidth="130"
                          SuggestedHeight="22"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Bottom"
                          MarginBottom="6"
                          MarginLeft="10"
                          IsVisible="@IsModelModeToggleVisible"
                          DoNotPassEventsToChildren="true"
                          Brush="ButtonBrush1"
                          UpdateChildrenStates="true"
                          Command.Click="ExecuteToggleModelMode">
              <Children>
                <TextWidget WidthSizePolicy="StretchToParent"
                            HeightSizePolicy="StretchToParent"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Brush="Popup.Button.Text"
                            Brush.FontSize="14"
                            Brush.FontColor="#b8b0a0FF"
                            Brush.TextHorizontalAlignment="Center"
                            Text="@ModelModeText" />
              </Children>
            </ButtonWidget>
          </Children>
        </Widget>

        <Widget Id="TitleDivider"
                WidthSizePolicy="StretchToParent"
                HeightSizePolicy="Fixed"
                SuggestedHeight="3"
                VerticalAlignment="Top"
                PositionYOffset="94"
                Sprite="BlankWhiteSquare_9"
                Color="#3a2f24FF"
                IsDisabled="true" />

        <Widget Id="MessagesArea"
                WidthSizePolicy="StretchToParent"
                HeightSizePolicy="StretchToParent"
                VerticalAlignment="Top"
                MarginTop="98"
                MarginBottom="226"
                MarginLeft="15"
                MarginRight="15">
          <Children>

            <ChatScrollablePanel Id="MessagesScrollPanel"
                                 WidthSizePolicy="StretchToParent"
                                 HeightSizePolicy="StretchToParent"
                                 MarginRight="32"
                                 AutoHideScrollBars="true"
                                 ClipRect="MessagesClipRect"
                                 InnerPanel="MessagesClipRect\MessagesList"
                                 VerticalScrollbar="..\MessagesScrollbar\Scrollbar">
              <Children>
                <Widget Id="MessagesClipRect"
                        WidthSizePolicy="StretchToParent"
                        HeightSizePolicy="StretchToParent"
                        ClipContents="true">
                  <Children>

                    <NavigatableListPanel Id="MessagesList"
                                          DataSource="{Messages}"
                                          WidthSizePolicy="StretchToParent"
                                          HeightSizePolicy="CoverChildren"
                                          HorizontalAlignment="Left"
                                          VerticalAlignment="Top"
                                          StackLayout.LayoutMethod="VerticalTopToBottom">
                      <ItemTemplate>

                        <Widget Id="MessageRow"
                                WidthSizePolicy="StretchToParent"
                                HeightSizePolicy="CoverChildren"
                                HorizontalAlignment="Left"
                                MarginTop="12"
                                MarginBottom="2">
                          <Children>

                            <Widget Id="AvatarContainer"
                                    WidthSizePolicy="Fixed"
                                    HeightSizePolicy="Fixed"
                                    SuggestedWidth="96"
                                    SuggestedHeight="88"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    MarginTop="2"
                                    IsVisible="@ShowAvatar"
                                    Sprite="BlankWhiteSquare_9"
                                    Color="#221d18FF"
                                    AlphaFactor="0.0">
                              <Children>

                                <ImageIdentifierWidget Id="AvatarPortrait"
                                                       WidthSizePolicy="Fixed"
                                                       HeightSizePolicy="Fixed"
                                                       SuggestedWidth="88"
                                                       SuggestedHeight="44"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Top"
                                                       TextureProviderName="@PortraitTextureProviderName"
                                                       ImageId="@PortraitId"
                                                       AdditionalArgs="@PortraitAdditionalArgs"
                                                       IsBig="true"
                                                       HideWhenNull="false"
                                                       IsDisabled="true" />

                                <Widget Id="AvatarFrame"
                                        WidthSizePolicy="StretchToParent"
                                        HeightSizePolicy="StretchToParent"                                        
                                        Sprite="frame_9"
                                        ExtendLeft="15" ExtendTop="22" ExtendRight="15" ExtendBottom="-22"
                                        AlphaFactor="0.25"
                                        IsDisabled="true" />
                              </Children>
                            </Widget>

                            <RichTextWidget Id="MessageText"
                                            WidthSizePolicy="StretchToParent"
                                            HeightSizePolicy="CoverChildren"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            MarginLeft="112"
                                            MarginRight="18"
                                            Brush="Default"
                                            Brush.FontSize="22"
                                            Brush.FontColor="@AuthorColor"
                                            Brush.TextHorizontalAlignment="Left"
                                            Text="@DisplayText"
                                            IsDisabled="true" />

                          </Children>
                        </Widget>

                      </ItemTemplate>
                    </NavigatableListPanel>

                  </Children>
                </Widget>
              </Children>
            </ChatScrollablePanel>

            <Standard.VerticalScrollbar Id="MessagesScrollbar"
                                        HeightSizePolicy="StretchToParent"
                                        HorizontalAlignment="Right"
                                        MarginRight="0" />

            <!-- Shown by ChatScrollablePanel only while there is unread text below the fold. -->
            <Widget Id="ScrollMoreHint"
                    WidthSizePolicy="CoverChildren"
                    HeightSizePolicy="CoverChildren"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    MarginBottom="4"
                    MarginRight="32"
                    IsVisible="false"
                    Sprite="BlankWhiteSquare_9"
                    Color="#0d0a08FF"
                    AlphaFactor="0.55">
              <Children>
                <TextWidget WidthSizePolicy="CoverChildren"
                            HeightSizePolicy="CoverChildren"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            MarginLeft="14"
                            MarginRight="14"
                            MarginTop="3"
                            MarginBottom="3"
                            Brush="Default"
                            Brush.FontSize="17"
                            Brush.FontColor="#e8d8b8FF"
                            Brush.TextHorizontalAlignment="Center"
                            Text="scroll down to read more..." />
              </Children>
            </Widget>

          </Children>
        </Widget>

        <ButtonWidget Id="OfferItemButton"
                      WidthSizePolicy="Fixed"
                      HeightSizePolicy="Fixed"
                      SuggestedWidth="56"
                      SuggestedHeight="56"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Bottom"
                      PositionXOffset="15"
                      PositionYOffset="-165"
                      IsVisible="@IsOfferItemVisible"
                      DoNotPassEventsToChildren="true"
                      UpdateChildrenStates="true"
                      Command.Click="ExecuteOfferItem">
          <Children>
            <Widget Id="OfferItemIcon"
                    WidthSizePolicy="Fixed"
                    HeightSizePolicy="Fixed"
                    SuggestedWidth="40"
                    SuggestedHeight="40"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Sprite="MapBar\mapbar_icon3"
                    Color="#c8a878FF"
                    IsDisabled="true" />
          </Children>
        </ButtonWidget>

        <ButtonWidget Id="OfferGoldButton"
                      WidthSizePolicy="Fixed"
                      HeightSizePolicy="Fixed"
                      SuggestedWidth="80"
                      SuggestedHeight="56"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Bottom"
                      PositionXOffset="80"
                      PositionYOffset="-165"
                      IsVisible="@IsOfferGoldVisible"
                      DoNotPassEventsToChildren="true"
                      Brush="ButtonBrush1"
                      UpdateChildrenStates="true"
                      Command.Click="ExecuteOfferGold">
          <Children>
            <TextWidget WidthSizePolicy="StretchToParent"
                        HeightSizePolicy="StretchToParent"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Brush="Popup.Button.Text"
                        Brush.FontSize="16"
                        Text="Give Gold" />
          </Children>
        </ButtonWidget>

        <Widget Id="InputArea"
                WidthSizePolicy="StretchToParent"
                HeightSizePolicy="Fixed"
                SuggestedHeight="78"
                VerticalAlignment="Bottom"
                PositionYOffset="-80"
                MarginLeft="15"
                MarginRight="5">
          <Children>

            <!-- Opens the left REVIEW panel (a wrapped, read-only view of your message). Hidden while it is open. -->
            <ButtonWidget Id="ComposeToggleButton"
                          WidthSizePolicy="Fixed"
                          HeightSizePolicy="Fixed"
                          SuggestedWidth="26"
                          SuggestedHeight="60"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Center"
                          IsVisible="@IsComposeToggleVisible"
                          DoNotPassEventsToChildren="true"
                          Brush="ButtonBrush1"
                          UpdateChildrenStates="true"
                          Command.Click="ExecuteOpenCompose">
              <Children>
                <TextWidget WidthSizePolicy="StretchToParent"
                            HeightSizePolicy="StretchToParent"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Brush="Popup.Button.Text"
                            Brush.FontSize="24"
                            Text="&lt;" />
              </Children>
            </ButtonWidget>

            <Widget Id="InputBox"
                         WidthSizePolicy="Fixed"
                         HeightSizePolicy="Fixed"
                         SuggestedWidth="490"
                         SuggestedHeight="60"
                         HorizontalAlignment="Left"
                         VerticalAlignment="Center"
                         PositionXOffset="48"
                         IsVisible="@IsChatInputVisible"
                         Sprite="BlankWhiteSquare_9"
                          Color="#0d0a08DD"
                          AlphaFactor="0.4">
              <Children>
                <EditableTextWidget Id="MessageInput"
                                    WidthSizePolicy="StretchToParent"
                                    HeightSizePolicy="StretchToParent"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    MarginLeft="12"
                                    MarginRight="12"
                                    MarginTop="6"
                                    MarginBottom="6"
                                    Brush="Default"
                                    Brush.FontSize="20"
                                    Brush.FontColor="#e8d8b8FF"
                                    Brush.TextHorizontalAlignment="Left"
                                    MaxLength="8000"
                                    Text="@InputText" />
              </Children>
            </Widget>

            <ButtonWidget Id="SendButton"
              WidthSizePolicy="Fixed"
              HeightSizePolicy="Fixed"
              SuggestedWidth="105"
              SuggestedHeight="60"
              HorizontalAlignment="Right"
              VerticalAlignment="Center"
              MarginRight="25"
              IsVisible="@IsChatInputVisible"
              DoNotPassEventsToChildren="true"
              Brush="ButtonBrush1"
              UpdateChildrenStates="true"
              IsEnabled="@IsSendEnabled"
              Command.Click="ExecuteSendMessage">
              <Children>
                <TextWidget Id="SendButtonTextWidget"
                            WidthSizePolicy="StretchToParent"
                            HeightSizePolicy="StretchToParent"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Brush="Popup.Button.Text"
                            Brush.FontSize="20"
                            Text="@SendButtonText" />
              </Children>
            </ButtonWidget>

            <ButtonWidget Id="ContinueButton"
              WidthSizePolicy="Fixed"
              HeightSizePolicy="Fixed"
              SuggestedWidth="200"
              SuggestedHeight="60"
              HorizontalAlignment="Right"
              VerticalAlignment="Center"
              MarginRight="245"
              IsVisible="@IsScenePaused"
              DoNotPassEventsToChildren="true"
              Brush="ButtonBrush1"
              UpdateChildrenStates="true"
              Command.Click="ExecuteContinue">
              <Children>
                <TextWidget WidthSizePolicy="StretchToParent"
                            HeightSizePolicy="StretchToParent"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Brush="Popup.Button.Text"
                            Brush.FontSize="20"
                            Text="Continue" />
              </Children>
            </ButtonWidget>

            <ButtonWidget Id="TrySomethingButton"
              WidthSizePolicy="Fixed"
              HeightSizePolicy="Fixed"
              SuggestedWidth="230"
              SuggestedHeight="60"
              HorizontalAlignment="Right"
              VerticalAlignment="Center"
              MarginRight="5"
              IsVisible="@IsScenePaused"
              DoNotPassEventsToChildren="true"
              Brush="ButtonBrush1"
              UpdateChildrenStates="true"
              Command.Click="ExecuteTrySomething">
              <Children>
                <TextWidget WidthSizePolicy="StretchToParent"
                            HeightSizePolicy="StretchToParent"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Brush="Popup.Button.Text"
                            Brush.FontSize="20"
                            Text="Try something else" />
              </Children>
            </ButtonWidget>

          </Children>
        </Widget>

        <ButtonWidget Id="PleaseContinueButton"
                      WidthSizePolicy="Fixed"
                      HeightSizePolicy="Fixed"
                      SuggestedWidth="230"
                      SuggestedHeight="44"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Bottom"
                      PositionYOffset="-75"
                      IsVisible="@IsPleaseContinueVisible"
                      DoNotPassEventsToChildren="true"
                      Brush="ButtonBrush1"
                      Brush.Color="#D9A441FF"
                      Brush.AlphaFactor="1.0"
                      UpdateChildrenStates="true"
                      Command.Click="ExecutePleaseContinue">
          <Children>
            <TextWidget WidthSizePolicy="StretchToParent"
                        HeightSizePolicy="StretchToParent"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Brush="Popup.Button.Text"
                        Brush.FontSize="20"
                        Text="Please continue" />
          </Children>
        </ButtonWidget>

        <ButtonWidget Id="CloseButton"
                      WidthSizePolicy="Fixed"
                      HeightSizePolicy="Fixed"
                      SuggestedWidth="230"
                      SuggestedHeight="44"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Bottom"
                      PositionYOffset="-25"
                      DoNotPassEventsToChildren="true"
                      Brush="ButtonBrush1"
                      UpdateChildrenStates="true"
                      Command.Click="ExecuteClose">
          <Children>
            <TextWidget Id="CloseButtonTextWidget"
                        WidthSizePolicy="StretchToParent"
                        HeightSizePolicy="StretchToParent"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Brush="Popup.Button.Text"
                        Brush.FontSize="20"
                        Text="@CloseButtonText" />
          </Children>
        </ButtonWidget>

      </Children>
    </Widget>

    <!-- Optional REVIEW panel, opened by the "<" button beside the small input. Sits to the left of the chat and
         shows a wrapped, read-only view of the message being typed, so a verbose player can read it all back.
         Editing stays in the small single-line box (Bannerlord's editable text is single-line only). -->
    <Widget Id="ComposePanel"
            WidthSizePolicy="Fixed"
            HeightSizePolicy="StretchToParent"
            SuggestedWidth="560"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            MarginTop="100"
            MarginBottom="100"
            PositionXOffset="-750"
            IsVisible="@IsComposeOpen"
            Sprite="BlankWhiteSquare_9"
            Color="#1a1612F2">
      <Children>

        <Widget Id="ComposePanelDecorativeFrame"
                WidthSizePolicy="StretchToParent"
                HeightSizePolicy="StretchToParent"
                Sprite="frame_9"
                ExtendLeft="8" ExtendTop="8" ExtendRight="8" ExtendBottom="8"
                AlphaFactor="0.4"
                IsDisabled="true" />

        <!-- Read-only WRAPPED preview of the message being typed in the small box on the right (RichTextWidget
             auto-wraps; EditableTextWidget is single-line only, so a verbose player edits on the right and reads
             the whole thing wrapped here). Updates live. In a scroll panel so a very long message can scroll. -->
        <Widget Id="ComposeInputBox"
                WidthSizePolicy="StretchToParent"
                HeightSizePolicy="StretchToParent"
                VerticalAlignment="Top"
                MarginTop="88"
                MarginBottom="94"
                MarginLeft="24"
                MarginRight="24"
                Sprite="BlankWhiteSquare_9"
                Color="#0d0a08DD"
                AlphaFactor="0.4">
          <Children>
            <ComposeScrollablePanel Id="ComposeScrollPanel"
                                    WidthSizePolicy="StretchToParent"
                                    HeightSizePolicy="StretchToParent"
                                    MarginRight="28"
                                    AutoHideScrollBars="true"
                                    ClipRect="ComposeClipRect"
                                    InnerPanel="ComposeClipRect\ComposePreview"
                                    VerticalScrollbar="..\ComposeScrollbar\Scrollbar">
              <Children>
                <Widget Id="ComposeClipRect"
                        WidthSizePolicy="StretchToParent"
                        HeightSizePolicy="StretchToParent"
                        ClipContents="true">
                  <Children>
                    <RichTextWidget Id="ComposePreview"
                                    WidthSizePolicy="StretchToParent"
                                    HeightSizePolicy="CoverChildren"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    MarginLeft="14"
                                    MarginRight="14"
                                    MarginTop="10"
                                    MarginBottom="10"
                                    Brush="Default"
                                    Brush.FontSize="20"
                                    Brush.FontColor="#e8d8b8FF"
                                    Brush.TextHorizontalAlignment="Left"
                                    Brush.TextVerticalAlignment="Top"
                                    Text="@InputText" />
                  </Children>
                </Widget>
              </Children>
            </ComposeScrollablePanel>

            <Standard.VerticalScrollbar Id="ComposeScrollbar"
                                        HeightSizePolicy="StretchToParent"
                                        HorizontalAlignment="Right"
                                        MarginRight="4" />
          </Children>
        </Widget>

        <!-- Closes the preview panel (editing + sending stay in the chat input on the right). -->
        <ButtonWidget Id="ComposeCloseButton"
                      WidthSizePolicy="Fixed"
                      HeightSizePolicy="Fixed"
                      SuggestedWidth="440"
                      SuggestedHeight="56"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Bottom"
                      MarginBottom="22"
                      DoNotPassEventsToChildren="true"
                      Brush="ButtonBrush1"
                      UpdateChildrenStates="true"
                      Command.Click="ExecuteCloseCompose">
          <Children>
            <TextWidget WidthSizePolicy="StretchToParent"
                        HeightSizePolicy="StretchToParent"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Brush="Popup.Button.Text"
                        Brush.FontSize="20"
                        Text="Close Preview" />
          </Children>
        </ButtonWidget>

      </Children>
    </Widget>

      </Children>
    </Widget>

  </Window>
</Prefab>
