<Prefab>
  <Constants>
    <Constant Name="Chat.Width"  Value="700" />
    <Constant Name="Avatar.Size" Value="55" />
  </Constants>

  <Window Id="CalradiaRemembersChatWindow" Layer="Overlay">

    <Widget Id="ChatPanel"
            WidthSizePolicy="Fixed"
            HeightSizePolicy="StretchToParent"
            SuggestedWidth="!Chat.Width"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            MarginTop="100"
            MarginBottom="100"
            PositionXOffset="-30"
            Sprite="BlankWhiteSquare_9"
            Color="#1a1612F2">

      <Children>

        <Widget Id="ChatPanelDecorativeFrame"
                WidthSizePolicy="StretchToParent"
                HeightSizePolicy="StretchToParent"
                Sprite="frame_9"
                ExtendLeft="8" ExtendTop="8" ExtendRight="8" ExtendBottom="8"
                AlphaFactor="0.4"
                IsDisabled="true" />

        <Widget Id="TitleBar"
                WidthSizePolicy="StretchToParent"
                HeightSizePolicy="Fixed"
                SuggestedHeight="95"
                VerticalAlignment="Top"
                Sprite="BlankWhiteSquare_9"
                Color="#0d0a08FF">
          <Children>
            <TextWidget Id="TitleTextWidget"
                        WidthSizePolicy="StretchToParent"
                        HeightSizePolicy="Fixed"
                        SuggestedHeight="40"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        MarginTop="6"
                        Brush="Default"
                        Brush.FontSize="24"
                        Brush.FontColor="#c8a878FF"
                        Brush.TextHorizontalAlignment="Center"
                        Text="@TitleText"
                        IsDisabled="true" />
            <TextWidget Id="WitnessesTextWidget"
                        WidthSizePolicy="StretchToParent"
                        HeightSizePolicy="Fixed"
                        SuggestedHeight="20"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        MarginTop="47"
                        IsVisible="@HasWitnesses"
                        Brush="Default"
                        Brush.FontSize="14"
                        Brush.FontColor="#7a9070FF"
                        Brush.TextHorizontalAlignment="Center"
                        Text="@WitnessesText"
                        IsDisabled="true" />
            <TextWidget Id="RelationSummaryWidget"
                        WidthSizePolicy="StretchToParent"
                        HeightSizePolicy="Fixed"
                        SuggestedHeight="22"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        MarginBottom="6"
                        Brush="Default"
                        Brush.FontSize="16"
                        Brush.FontColor="#9a8a78FF"
                        Brush.TextHorizontalAlignment="Center"
                        Text="@RelationSummary"
                        IsDisabled="true" />
            <ButtonWidget Id="RequestPrivateButton"
                          WidthSizePolicy="Fixed"
                          HeightSizePolicy="Fixed"
                          SuggestedWidth="130"
                          SuggestedHeight="22"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Bottom"
                          MarginBottom="6"
                          MarginRight="10"
                          IsVisible="@IsPrivateRequestVisible"
                          DoNotPassEventsToChildren="true"
                          Brush="ButtonBrush1"
                          UpdateChildrenStates="true"
                          Command.Click="ExecuteRequestPrivate">
              <Children>
                <TextWidget WidthSizePolicy="StretchToParent"
                            HeightSizePolicy="StretchToParent"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Brush="Popup.Button.Text"
                            Brush.FontSize="14"
                            Text="Request Private" />
              </Children>
            </ButtonWidget>
          </Children>
        </Widget>

        <Widget Id="TitleDivider"
                WidthSizePolicy="StretchToParent"
                HeightSizePolicy="Fixed"
                SuggestedHeight="3"
                VerticalAlignment="Top"
                PositionYOffset="94"
                Sprite="BlankWhiteSquare_9"
                Color="#3a2f24FF"
                IsDisabled="true" />

        <Widget Id="MessagesArea"
                WidthSizePolicy="StretchToParent"
                HeightSizePolicy="StretchToParent"
                VerticalAlignment="Top"
                MarginTop="98"
                MarginBottom="165"
                MarginLeft="15"
                MarginRight="15">
          <Children>

            <ChatScrollablePanel Id="MessagesScrollPanel"
                                 WidthSizePolicy="StretchToParent"
                                 HeightSizePolicy="StretchToParent"
                                 MarginRight="32"
                                 AutoHideScrollBars="true"
                                 ClipRect="MessagesClipRect"
                                 InnerPanel="MessagesClipRect\MessagesList"
                                 VerticalScrollbar="..\MessagesScrollbar\Scrollbar">
              <Children>
                <Widget Id="MessagesClipRect"
                        WidthSizePolicy="StretchToParent"
                        HeightSizePolicy="StretchToParent"
                        ClipContents="true">
                  <Children>

                    <NavigatableListPanel Id="MessagesList"
                                          DataSource="{Messages}"
                                          WidthSizePolicy="StretchToParent"
                                          HeightSizePolicy="CoverChildren"
                                          HorizontalAlignment="Left"
                                          VerticalAlignment="Top"
                                          StackLayout.LayoutMethod="VerticalTopToBottom">
                      <ItemTemplate>

                        <Widget Id="MessageRow"
                                WidthSizePolicy="StretchToParent"
                                HeightSizePolicy="CoverChildren"
                                HorizontalAlignment="Left"
                                MarginTop="12"
                                MarginBottom="2">
                          <Children>

                            <Widget Id="AvatarContainer"
                                    WidthSizePolicy="Fixed"
                                    HeightSizePolicy="Fixed"
                                    SuggestedWidth="96"
                                    SuggestedHeight="88"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    MarginTop="2"
                                    IsVisible="@ShowAvatar"
                                    Sprite="BlankWhiteSquare_9"
                                    Color="#221d18FF"
                                    AlphaFactor="0.0">
                              <Children>

                                <ImageIdentifierWidget Id="AvatarPortrait"
                                                       WidthSizePolicy="Fixed"
                                                       HeightSizePolicy="Fixed"
                                                       SuggestedWidth="88"
                                                       SuggestedHeight="44"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Top"
                                                       TextureProviderName="@PortraitTextureProviderName"
                                                       ImageId="@PortraitId"
                                                       AdditionalArgs="@PortraitAdditionalArgs"
                                                       IsBig="true"
                                                       HideWhenNull="false"
                                                       IsDisabled="true" />

                                <Widget Id="AvatarFrame"
                                        WidthSizePolicy="StretchToParent"
                                        HeightSizePolicy="StretchToParent"                                        
                                        Sprite="frame_9"
                                        ExtendLeft="15" ExtendTop="22" ExtendRight="15" ExtendBottom="-22"
                                        AlphaFactor="0.25"
                                        IsDisabled="true" />
                              </Children>
                            </Widget>

                            <RichTextWidget Id="MessageText"
                                            WidthSizePolicy="StretchToParent"
                                            HeightSizePolicy="CoverChildren"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            MarginLeft="112"
                                            MarginRight="18"
                                            Brush="Default"
                                            Brush.FontSize="22"
                                            Brush.FontColor="@AuthorColor"
                                            Brush.TextHorizontalAlignment="Left"
                                            Text="@DisplayText"
                                            IsDisabled="true" />

                          </Children>
                        </Widget>

                      </ItemTemplate>
                    </NavigatableListPanel>

                  </Children>
                </Widget>
              </Children>
            </ChatScrollablePanel>

            <Standard.VerticalScrollbar Id="MessagesScrollbar"
                                        HeightSizePolicy="StretchToParent"
                                        HorizontalAlignment="Right"
                                        MarginRight="0" />

          </Children>
        </Widget>

        <Widget Id="InputArea"
                WidthSizePolicy="StretchToParent"
                HeightSizePolicy="Fixed"
                SuggestedHeight="78"
                VerticalAlignment="Bottom"
                PositionYOffset="-80"
                MarginLeft="15"
                MarginRight="5">
          <Children>

            <Widget Id="InputBox"
                         WidthSizePolicy="Fixed"
                         HeightSizePolicy="Fixed"
                         SuggestedWidth="550"
                         SuggestedHeight="60"
                         HorizontalAlignment="Left"
                         VerticalAlignment="Center"
                         IsVisible="@IsNormalInputVisible"
                         Sprite="BlankWhiteSquare_9"
                          Color="#0d0a08DD"
                          AlphaFactor="0.4">
              <Children>
                <EditableTextWidget Id="MessageInput"
                                    WidthSizePolicy="StretchToParent"
                                    HeightSizePolicy="StretchToParent"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    MarginLeft="12"
                                    MarginRight="12"
                                    MarginTop="6"
                                    MarginBottom="6"
                                    Brush="Default"
                                    Brush.FontSize="20"
                                    Brush.FontColor="#e8d8b8FF"
                                    Brush.TextHorizontalAlignment="Left"
                                    Text="@InputText" />
              </Children>
            </Widget>

            <ButtonWidget Id="SendButton"
              WidthSizePolicy="Fixed"
              HeightSizePolicy="Fixed"
              SuggestedWidth="105"
              SuggestedHeight="60"
              HorizontalAlignment="Right"
              VerticalAlignment="Center"
              MarginRight="25"
              IsVisible="@IsNormalInputVisible"
              DoNotPassEventsToChildren="true"
              Brush="ButtonBrush1"
              UpdateChildrenStates="true"
              IsEnabled="@IsSendEnabled"
              Command.Click="ExecuteSendMessage">
              <Children>
                <TextWidget Id="SendButtonTextWidget"
                            WidthSizePolicy="StretchToParent"
                            HeightSizePolicy="StretchToParent"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Brush="Popup.Button.Text"
                            Brush.FontSize="20"
                            Text="@SendButtonText" />
              </Children>
            </ButtonWidget>

            <ButtonWidget Id="ContinueButton"
              WidthSizePolicy="Fixed"
              HeightSizePolicy="Fixed"
              SuggestedWidth="200"
              SuggestedHeight="60"
              HorizontalAlignment="Right"
              VerticalAlignment="Center"
              MarginRight="245"
              IsVisible="@IsScenePaused"
              DoNotPassEventsToChildren="true"
              Brush="ButtonBrush1"
              UpdateChildrenStates="true"
              Command.Click="ExecuteContinue">
              <Children>
                <TextWidget WidthSizePolicy="StretchToParent"
                            HeightSizePolicy="StretchToParent"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Brush="Popup.Button.Text"
                            Brush.FontSize="20"
                            Text="Continue" />
              </Children>
            </ButtonWidget>

            <ButtonWidget Id="TrySomethingButton"
              WidthSizePolicy="Fixed"
              HeightSizePolicy="Fixed"
              SuggestedWidth="230"
              SuggestedHeight="60"
              HorizontalAlignment="Right"
              VerticalAlignment="Center"
              MarginRight="5"
              IsVisible="@IsScenePaused"
              DoNotPassEventsToChildren="true"
              Brush="ButtonBrush1"
              UpdateChildrenStates="true"
              Command.Click="ExecuteTrySomething">
              <Children>
                <TextWidget WidthSizePolicy="StretchToParent"
                            HeightSizePolicy="StretchToParent"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Brush="Popup.Button.Text"
                            Brush.FontSize="20"
                            Text="Try something" />
              </Children>
            </ButtonWidget>

          </Children>
        </Widget>

        <ButtonWidget Id="CloseButton"
                      WidthSizePolicy="Fixed"
                      HeightSizePolicy="Fixed"
                      SuggestedWidth="230"
                      SuggestedHeight="44"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Bottom"
                      PositionYOffset="-25"
                      DoNotPassEventsToChildren="true"
                      Brush="ButtonBrush1"
                      UpdateChildrenStates="true"
                      Command.Click="ExecuteClose">
          <Children>
            <TextWidget Id="CloseButtonTextWidget"
                        WidthSizePolicy="StretchToParent"
                        HeightSizePolicy="StretchToParent"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Brush="Popup.Button.Text"
                        Brush.FontSize="20"
                        Text="@CloseButtonText" />
          </Children>
        </ButtonWidget>

      </Children>
    </Widget>

  </Window>
</Prefab>
