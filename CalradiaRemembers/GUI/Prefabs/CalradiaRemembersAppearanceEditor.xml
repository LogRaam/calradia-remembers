<Prefab>
  <Window Id="CalradiaRemembersAppearanceEditorWindow" Layer="Overlay">

    <!-- Full-screen dimmed backdrop = single Window root; the panel is its child -->
    <Widget Id="Backdrop"
            WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
            Sprite="BlankWhiteSquare_9" Color="#000000AA">
      <Children>

        <Widget Id="Panel"
                WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                SuggestedWidth="700" SuggestedHeight="480"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Sprite="BlankWhiteSquare_9" Color="#1c1812F9">
          <Children>

            <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                    Sprite="frame_9" ExtendLeft="10" ExtendTop="10" ExtendRight="10" ExtendBottom="10"
                    AlphaFactor="0.5" IsDisabled="true" />

            <ListPanel StackLayout.LayoutMethod="VerticalTopToBottom"
                       WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren"
                       VerticalAlignment="Top" MarginTop="26" MarginLeft="34" MarginRight="34">
              <Children>

                <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="40"
                            MarginBottom="10"
                            Brush="Default" Brush.FontSize="26" Brush.FontColor="#c8a878FF"
                            Brush.TextHorizontalAlignment="Left" Text="@Title" />

                <RichTextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren"
                                MarginBottom="16"
                                Brush="Default" Brush.FontSize="17" Brush.FontColor="#b8a888FF"
                                Text="@Explanation" />

                <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="46"
                        MarginBottom="18"
                        Sprite="BlankWhiteSquare_9" Color="#0d0a08DD" AlphaFactor="0.55">
                  <Children>
                    <EditableTextWidget Id="NoteInput"
                                        WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                        HorizontalAlignment="Left" VerticalAlignment="Center"
                                        MarginLeft="12" MarginRight="12"
                                        Brush="Default" Brush.FontSize="18" Brush.FontColor="#e8d8b8FF"
                                        Brush.TextHorizontalAlignment="Left"
                                        MaxLength="300" Text="@NoteText" />
                  </Children>
                </Widget>

                <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="28"
                            MarginBottom="4"
                            Brush="Default" Brush.FontSize="16" Brush.FontColor="#9a8a78FF"
                            Brush.TextHorizontalAlignment="Left" Text="@PreviewLabel" />

                <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="150"
                        Sprite="BlankWhiteSquare_9" Color="#0d0a08AA" AlphaFactor="0.4">
                  <Children>
                    <RichTextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren"
                                    VerticalAlignment="Top" MarginLeft="12" MarginRight="12" MarginTop="10"
                                    Brush="Default" Brush.FontSize="17" Brush.FontColor="#d8c8a8FF"
                                    Text="@PreviewText" />
                  </Children>
                </Widget>

              </Children>
            </ListPanel>

            <ListPanel StackLayout.LayoutMethod="HorizontalLeftToRight"
                       WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren"
                       HorizontalAlignment="Center" VerticalAlignment="Bottom" MarginBottom="26">
              <Children>
                <ButtonWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="180" SuggestedHeight="42"
                              MarginRight="16"
                              Brush="ButtonBrush1" DoNotPassEventsToChildren="true" UpdateChildrenStates="true"
                              Command.Click="ExecuteConfirm">
                  <Children>
                    <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Brush="Popup.Button.Text" Brush.FontSize="18" Text="@ConfirmButtonText" />
                  </Children>
                </ButtonWidget>
                <ButtonWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="180" SuggestedHeight="42"
                              Brush="ButtonBrush1" DoNotPassEventsToChildren="true" UpdateChildrenStates="true"
                              Command.Click="ExecuteCancel">
                  <Children>
                    <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Brush="Popup.Button.Text" Brush.FontSize="18" Text="@CancelButtonText" />
                  </Children>
                </ButtonWidget>
              </Children>
            </ListPanel>

          </Children>
        </Widget>

      </Children>
    </Widget>
  </Window>
</Prefab>
