<DummyRoot>
  <!-- Gabriel (22/10/2026): one row per friend or enemy, the portrait, the status, the reason, a pale green or red marker. -->
  <!-- Folded by its header (LapitaPolata, 15/11/2026). The switch sits on a parent: a binding on the widget that carries
       DataSource would be read from the list. A hidden widget measures zero (Widget.Measure, 1.4.8). -->
  <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" IsVisible="@CalradiaRegardWhyShown">
    <Children>
  <ListPanel DataSource="{CalradiaRegardPeople}"
             StackLayout.LayoutMethod="VerticalTopToBottom"
             WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren"
             HorizontalAlignment="Left"
             MarginTop="6" MarginLeft="30" MarginBottom="4">
    <ItemTemplate>
      <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" MarginBottom="8">
        <Children>
          <!-- The marker has a fixed height (the portrait's): a StretchToParent child inside a CoverChildren row is measured against
               all the room the page offers (Widget.Measure, 1.4.8), so each row stood as tall as the page (Gabriel 23/10). -->
          <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="5" SuggestedHeight="100" HorizontalAlignment="Left"
                  VerticalAlignment="Top" Sprite="BlankWhiteSquare_9" Color="#9CCB8CFF" IsVisible="@IsFriend" />
          <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="5" SuggestedHeight="100" HorizontalAlignment="Left"
                  VerticalAlignment="Top" Sprite="BlankWhiteSquare_9" Color="#C0453CFF" IsHidden="@IsFriend" />
          <ListPanel StackLayout.LayoutMethod="HorizontalLeftToRight"
                     WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" MarginLeft="5">
            <Children>
          <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="100" SuggestedHeight="100" MarginLeft="8">
            <Children>
              <EncyclopediaSubPageElement DataSource="{Person}" VerticalAlignment="Top" />
            </Children>
          </Widget>
          <ListPanel StackLayout.LayoutMethod="VerticalTopToBottom"
                     WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren"
                     VerticalAlignment="Top" MarginLeft="10" MarginTop="4">
            <Children>
              <RichTextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren"
                              Brush="Encyclopedia.Stat.DefinitionText" Brush.TextHorizontalAlignment="Left"
                              Text="@Status" />
              <AutoHideRichTextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren"
                                      Brush="Encyclopedia.Stat.ValueText" Brush.TextHorizontalAlignment="Left"
                                      Text="@Reason" MarginTop="2" />
            </Children>
          </ListPanel>
            </Children>
          </ListPanel>
        </Children>
      </Widget>
    </ItemTemplate>
  </ListPanel>
    </Children>
  </Widget>
</DummyRoot>
