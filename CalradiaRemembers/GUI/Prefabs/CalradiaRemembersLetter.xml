<Prefab>
  <!--
    The letter window as an open leather BOOK (Gabriel's art, cr_letters.jpg), a fixed-size centered widget so
    the painted borders never distort (aspect 1402:1122). Left page = the whole dated correspondence thread with
    this contact (always shown). Right page = the current letter: sender portrait,
    body, signature. Buttons sit on the bottom leather strip. Compose/reply reuse the same book (the writing field
    replaces the read body on the right page).

    V1 built from Gabriel's mockup; control positions are estimated and meant to be tuned in-game (same as the
    Manuscript chat skin). NOT yet reproduced from the mockup (pending a decision / art): the name-first "1086th
    year" header style, the per-entry wax seals, and the floral vignette on the portrait. (No illuminated drop-cap:
    Gabriel's call, 2026-08-24.)
  -->
  <Constants>
    <Constant Name="Book.Width"  Value="1180" />
    <Constant Name="Book.Height" Value="944" />
  </Constants>

  <Window Id="CalradiaRemembersLetterWindow" Layer="Overlay">

    <Widget Id="ScreenRoot"
            WidthSizePolicy="StretchToParent"
            HeightSizePolicy="StretchToParent">
      <Children>

        <!-- The book: fixed size (aspect-locked to the art), centered. -->
        <Widget Id="BookRoot"
                WidthSizePolicy="Fixed"
                HeightSizePolicy="Fixed"
                SuggestedWidth="!Book.Width"
                SuggestedHeight="!Book.Height"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
          <Children>

            <!-- Full-book leather background art. CorrectRedBlue=true matches the other mod JPGs (they read with
                 red/blue swapped in game); flip to false in-game if the wax seal looks blue. -->
            <CrRuntimeImageWidget Id="BookBackground"
                                  WidthSizePolicy="StretchToParent"
                                  HeightSizePolicy="StretchToParent"
                                  ImagePath="@LetterBookBackgroundPath"
                                  CorrectRedBlue="true"
                                  IsDisabled="true" />

            <!-- ============================ LEFT PAGE: the correspondence thread (always shown) ============================ -->
            <Widget Id="LeftPage"
                    WidthSizePolicy="Fixed"
                    HeightSizePolicy="Fixed"
                    SuggestedWidth="402"
                    SuggestedHeight="!Book.Height"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    MarginLeft="47">
              <Children>

                <TextWidget Id="HistoryTitle"
                            WidthSizePolicy="StretchToParent"
                            HeightSizePolicy="Fixed"
                            SuggestedHeight="40"
                            VerticalAlignment="Top"
                            MarginTop="76"
                            MarginLeft="22"
                            MarginRight="22"
                            Brush="@HeadingBrush"
                            Brush.FontSize="26"
                            Brush.TextHorizontalAlignment="Center"
                            Text="@HistoryTitle"
                            IsDisabled="true" />

                <Widget Id="HistoryTitleDivider"
                        WidthSizePolicy="Fixed"
                        SuggestedWidth="300"
                        HeightSizePolicy="Fixed"
                        SuggestedHeight="2"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        PositionYOffset="122"
                        Sprite="BlankWhiteSquare_9"
                        Color="#6A5028FF"
                        AlphaFactor="0.7"
                        IsDisabled="true" />

                <!-- Empty-state line (a fresh contact with no letters yet) -->
                <TextWidget Id="HistoryEmpty"
                            WidthSizePolicy="StretchToParent"
                            HeightSizePolicy="Fixed"
                            SuggestedHeight="60"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            MarginLeft="26"
                            MarginRight="26"
                            IsVisible="@HistoryIsEmpty"
                            Brush="@HeadingBrush"
                            Brush.FontSize="18"
                            Brush.TextHorizontalAlignment="Center"
                            Text="@HistoryEmptyText"
                            IsDisabled="true" />

                <!-- Scrollable list of correspondence entries -->
                <Widget Id="HistoryEntriesArea"
                        WidthSizePolicy="StretchToParent"
                        HeightSizePolicy="StretchToParent"
                        VerticalAlignment="Top"
                        MarginTop="150"
                        MarginBottom="96"
                        MarginLeft="26"
                        MarginRight="22">
                  <Children>

                    <ChatScrollablePanel Id="HistoryScrollPanel"
                                         WidthSizePolicy="StretchToParent"
                                         HeightSizePolicy="StretchToParent"
                                         MarginRight="20"
                                         AutoHideScrollBars="true"
                                         ClipRect="HistoryClipRect"
                                         InnerPanel="HistoryClipRect\HistoryList"
                                         VerticalScrollbar="..\HistoryScrollbar\Scrollbar">
                      <Children>
                        <Widget Id="HistoryClipRect"
                                WidthSizePolicy="StretchToParent"
                                HeightSizePolicy="StretchToParent"
                                ClipContents="true">
                          <Children>

                            <NavigatableListPanel Id="HistoryList"
                                                  DataSource="{HistoryEntries}"
                                                  WidthSizePolicy="StretchToParent"
                                                  HeightSizePolicy="CoverChildren"
                                                  HorizontalAlignment="Left"
                                                  VerticalAlignment="Top"
                                                  StackLayout.LayoutMethod="VerticalTopToBottom">
                              <ItemTemplate>

                                <ListPanel Id="HistoryEntryRow"
                                           WidthSizePolicy="StretchToParent"
                                           HeightSizePolicy="CoverChildren"
                                           HorizontalAlignment="Left"
                                           MarginTop="8"
                                           MarginBottom="12"
                                           MarginRight="12"
                                           StackLayout.LayoutMethod="VerticalTopToBottom">
                                  <Children>

                                    <!-- Incoming attribution (a letter from the NPC): deep gold ink -->
                                    <TextWidget Id="HistoryHeaderIn"
                                                WidthSizePolicy="StretchToParent"
                                                HeightSizePolicy="Fixed"
                                                SuggestedHeight="24"
                                                HorizontalAlignment="Left"
                                                IsVisible="@IsIncoming"
                                                Brush="@BodyBrush"
                                                Brush.FontSize="15"
                                                Brush.FontColor="#7A4E14FF"
                                                Brush.TextHorizontalAlignment="Left"
                                                Text="@Header"
                                                IsDisabled="true" />

                                    <!-- Outgoing attribution (the player's own letter/reply): muted blue-grey ink -->
                                    <TextWidget Id="HistoryHeaderOut"
                                                WidthSizePolicy="StretchToParent"
                                                HeightSizePolicy="Fixed"
                                                SuggestedHeight="24"
                                                HorizontalAlignment="Left"
                                                IsVisible="@IsOutgoing"
                                                Brush="@BodyBrush"
                                                Brush.FontSize="15"
                                                Brush.FontColor="#3B4A63FF"
                                                Brush.TextHorizontalAlignment="Left"
                                                Text="@Header"
                                                IsDisabled="true" />

                                    <RichTextWidget Id="HistoryEntryBody"
                                                    WidthSizePolicy="StretchToParent"
                                                    HeightSizePolicy="CoverChildren"
                                                    HorizontalAlignment="Left"
                                                    MarginTop="2"
                                                    MarginLeft="6"
                                                    Brush="@BodyBrush"
                                                    Brush.FontSize="18"
                                                    Text="@Body"
                                                    IsDisabled="true" />

                                    <Widget Id="HistoryEntryDivider"
                                            WidthSizePolicy="StretchToParent"
                                            HeightSizePolicy="Fixed"
                                            SuggestedHeight="1"
                                            MarginTop="8"
                                            Sprite="BlankWhiteSquare_9"
                                            Color="#6A502840"
                                            IsDisabled="true" />

                                  </Children>
                                </ListPanel>

                              </ItemTemplate>
                            </NavigatableListPanel>

                          </Children>
                        </Widget>
                      </Children>
                    </ChatScrollablePanel>

                    <Standard.VerticalScrollbar Id="HistoryScrollbar"
                                                HeightSizePolicy="StretchToParent"
                                                HorizontalAlignment="Right"
                                                MarginRight="0" />

                  </Children>
                </Widget>

              </Children>
            </Widget>

            <!-- ============================ RIGHT PAGE: the current letter ============================ -->
            <Widget Id="RightPage"
                    WidthSizePolicy="Fixed"
                    HeightSizePolicy="Fixed"
                    SuggestedWidth="649"
                    SuggestedHeight="784"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    MarginRight="35">
              <Children>

                <!-- Correspondent portrait (sender when reading/replying, recipient when composing) -->
                <Widget Id="LetterPortraitFrame"
                        WidthSizePolicy="Fixed"
                        HeightSizePolicy="Fixed"
                        SuggestedWidth="250"
                        SuggestedHeight="206"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        MarginTop="30"
                        MarginRight="60"
                        IsVisible="@ShowPortrait">
                  <Children>
                    <ImageIdentifierWidget Id="LetterPortrait"
                                           WidthSizePolicy="Fixed"
                                           HeightSizePolicy="Fixed"
                                           SuggestedWidth="300"
                                           SuggestedHeight="150"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           TextureProviderName="@PortraitTextureProviderName"
                                           ImageId="@PortraitId"
                                           AdditionalArgs="@PortraitAdditionalArgs"
                                           IsBig="true"
                                           HideWhenNull="false"
                                           IsDisabled="true" />
                  </Children>
                </Widget>

                <!-- Small context line (From / To / Reply to …) -->
                <TextWidget Id="LetterHeading"
                            WidthSizePolicy="StretchToParent"
                            HeightSizePolicy="Fixed"
                            SuggestedHeight="28"
                            VerticalAlignment="Top"
                            MarginTop="250"
                            MarginLeft="40"
                            MarginRight="40"
                            Brush="@HeadingBrush"
                            Brush.FontSize="18"
                            Brush.TextHorizontalAlignment="Left"
                            Text="@SenderHeading"
                            IsDisabled="true" />

                <Widget Id="RightTitleDivider"
                        WidthSizePolicy="Fixed"
                        SuggestedWidth="560"
                        HeightSizePolicy="Fixed"
                        SuggestedHeight="2"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        PositionYOffset="286"
                        Sprite="BlankWhiteSquare_9"
                        Color="#6A5028FF"
                        AlphaFactor="0.7"
                        IsDisabled="true" />

                <!-- The letter body, on the right page (read / reply) -->
                <Widget Id="ReceivedArea"
                        WidthSizePolicy="StretchToParent"
                        HeightSizePolicy="StretchToParent"
                        VerticalAlignment="Top"
                        MarginTop="304"
                        MarginBottom="150"
                        MarginLeft="42"
                        MarginRight="46"
                        IsVisible="@ShowReceivedBody">
                  <Children>

                    <ChatScrollablePanel Id="ReceivedScrollPanel"
                                         WidthSizePolicy="StretchToParent"
                                         HeightSizePolicy="StretchToParent"
                                         MarginRight="18"
                                         AutoHideScrollBars="true"
                                         ClipRect="ReceivedClipRect"
                                         InnerPanel="ReceivedClipRect\ReceivedInner"
                                         VerticalScrollbar="..\ReceivedScrollbar\Scrollbar">
                      <Children>
                        <Widget Id="ReceivedClipRect"
                                WidthSizePolicy="StretchToParent"
                                HeightSizePolicy="StretchToParent"
                                ClipContents="true">
                          <Children>
                            <ListPanel Id="ReceivedInner"
                                       WidthSizePolicy="StretchToParent"
                                       HeightSizePolicy="CoverChildren"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Top"
                                       StackLayout.LayoutMethod="VerticalTopToBottom">
                              <Children>
                                <RichTextWidget Id="ReceivedBodyText"
                                                WidthSizePolicy="StretchToParent"
                                                HeightSizePolicy="CoverChildren"
                                                HorizontalAlignment="Left"
                                                Brush="@BodyBrush"
                                                Brush.FontSize="21"
                                                Text="@ReceivedBody"
                                                IsDisabled="true" />
                              </Children>
                            </ListPanel>
                          </Children>
                        </Widget>
                      </Children>
                    </ChatScrollablePanel>

                    <Standard.VerticalScrollbar Id="ReceivedScrollbar"
                                                HeightSizePolicy="StretchToParent"
                                                HorizontalAlignment="Right"
                                                MarginRight="0" />

                  </Children>
                </Widget>

                <!-- Courier fee note (compose) -->
                <TextWidget Id="CourierNoteWidget"
                            WidthSizePolicy="StretchToParent"
                            HeightSizePolicy="Fixed"
                            SuggestedHeight="22"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Bottom"
                            MarginBottom="96"
                            IsVisible="@HasCourierNote"
                            Brush="@HeadingBrush"
                            Brush.FontSize="15"
                            Brush.TextHorizontalAlignment="Center"
                            Text="@CourierNote"
                            IsDisabled="true" />

                <!-- Writing area (compose / reply) -->
                <Widget Id="InputBox"
                        WidthSizePolicy="Fixed"
                        HeightSizePolicy="Fixed"
                        SuggestedWidth="520"
                        SuggestedHeight="58"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        MarginBottom="30"
                        IsVisible="@ShowInput"
                        Sprite="BlankWhiteSquare_9"
                        Color="#C8B488FF"
                        AlphaFactor="0.55">
                  <Children>
                    <Widget Id="InputBoxBorder"
                            WidthSizePolicy="StretchToParent"
                            HeightSizePolicy="StretchToParent"
                            Sprite="frame_9"
                            ExtendLeft="6" ExtendTop="6" ExtendRight="6" ExtendBottom="6"
                            AlphaFactor="0.55"
                            IsDisabled="true" />
                    <EditableTextWidget Id="LetterInput"
                                        WidthSizePolicy="StretchToParent"
                                        HeightSizePolicy="StretchToParent"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        MarginLeft="26"
                                        MarginRight="26"
                                        MarginTop="8"
                                        MarginBottom="8"
                                        Brush="@InputBrush"
                                        MaxLength="8000"
                                        Text="@InputText" />
                  </Children>
                </Widget>

              </Children>
            </Widget>

            <!-- ============================ Buttons: bottom leather strip ============================ -->
            <ListPanel Id="LetterButtons"
                       WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren"
                       HorizontalAlignment="Right" VerticalAlignment="Bottom"
                       MarginRight="110" MarginBottom="22"
                       StackLayout.LayoutMethod="HorizontalLeftToRight">
              <Children>

                <ButtonWidget Id="AcknowledgeButton" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                              SuggestedWidth="240" SuggestedHeight="44" MarginRight="14"
                              IsVisible="@ShowAcknowledge"
                              Brush="ButtonBrush1" DoNotPassEventsToChildren="true" UpdateChildrenStates="true"
                              Command.Click="ExecuteAcknowledge">
                  <Children>
                    <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Brush="Popup.Button.Text" Brush.FontSize="18" Text="@AcknowledgeButtonText" />
                  </Children>
                </ButtonWidget>

                <ButtonWidget Id="ReplyButton" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                              SuggestedWidth="240" SuggestedHeight="44"
                              IsVisible="@ShowReplyButton"
                              Brush="ButtonBrush1" DoNotPassEventsToChildren="true" UpdateChildrenStates="true"
                              Command.Click="ExecuteReply">
                  <Children>
                    <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Brush="Popup.Button.Text" Brush.FontSize="18" Text="@ReplyButtonText" />
                  </Children>
                </ButtonWidget>

                <ButtonWidget Id="SendButton" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                              SuggestedWidth="240" SuggestedHeight="44" MarginRight="14"
                              IsVisible="@ShowSend" IsEnabled="@IsSendEnabled"
                              Brush="ButtonBrush1" DoNotPassEventsToChildren="true" UpdateChildrenStates="true"
                              Command.Click="ExecuteSend">
                  <Children>
                    <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Brush="Popup.Button.Text" Brush.FontSize="18" Text="@SendButtonText" />
                  </Children>
                </ButtonWidget>

                <ButtonWidget Id="CloseButton" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                              SuggestedWidth="200" SuggestedHeight="44"
                              IsVisible="@ShowSend"
                              Brush="ButtonBrush1" DoNotPassEventsToChildren="true" UpdateChildrenStates="true"
                              Command.Click="ExecuteClose">
                  <Children>
                    <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Brush="Popup.Button.Text" Brush.FontSize="18" Text="@CloseButtonText" />
                  </Children>
                </ButtonWidget>

              </Children>
            </ListPanel>

          </Children>
        </Widget>

      </Children>
    </Widget>

  </Window>
</Prefab>
