<DummyRoot>
  <!-- Appended into FinancePanelWidget (265 wide) and lifted above its top edge via a negative PositionYOffset, so it
       reads as a header over the Finance column. The panel does not clip its children, so the lift is visible. Tune
       PositionYOffset / width with cr.reload_ui if the anchor drifts. -->
  <ButtonWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                SuggestedWidth="245" SuggestedHeight="42"
                HorizontalAlignment="Center" VerticalAlignment="Top"
                PositionYOffset="-54"
                Brush="ButtonBrush1"
                DoNotPassEventsToChildren="true"
                UpdateChildrenStates="true"
                Command.Click="ExecuteOpenBalanceOfPower">
    <Children>
      <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                  HorizontalAlignment="Center" VerticalAlignment="Center"
                  Brush="Popup.Button.Text"
                  Brush.FontSize="20"
                  Text="@BalanceOfPowerButtonText" />
    </Children>
  </ButtonWidget>
</DummyRoot>
