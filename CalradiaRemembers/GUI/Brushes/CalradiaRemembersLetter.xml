<Brushes>

  <!--
    Parchment letter TEXT brushes — Galahad (the vanilla serif) with every shadow/glow/outline OFF,
    so dark ink reads crisp on the parchment instead of the bold, smeared look the default brush gives
    on a light background. Mirrors Native's GameNotification.Text. (The panel fill is a plain sprite on
    the widget — a bare Widget does not paint a brush fill, so the parchment colour lives in the prefab.)
  -->

  <!-- Letter body: dark ink, clean serif, left-aligned, no shadow/glow/outline. -->
  <Brush Name="CR.Letter.Body" Font="Galahad" TextHorizontalAlignment="Left" TextVerticalAlignment="Top">
    <Layers />
    <Styles>
      <Style Name="Default" FontColor="#2A1A0EFF" FontSize="23"
             TextGlowRadius="0" TextBlur="0" TextShadowOffset="0"
             TextOutlineAmount="0.0" TextOutlineColor="#00000000" />
    </Styles>
  </Brush>

  <!-- Small centered context line above the divider (From / To / Reply to …). -->
  <Brush Name="CR.Letter.Heading" Font="Galahad" TextHorizontalAlignment="Center">
    <Layers />
    <Styles>
      <Style Name="Default" FontColor="#5A3C1CFF" FontSize="22"
             TextGlowRadius="0" TextBlur="0" TextShadowOffset="0"
             TextOutlineAmount="0.0" TextOutlineColor="#00000000" />
    </Styles>
  </Brush>

  <!-- The reply/compose writing field — same crisp ink, the player's own hand. Single line, centered. -->
  <Brush Name="CR.Letter.Input" Font="Galahad" TextHorizontalAlignment="Left" TextVerticalAlignment="Center">
    <Layers />
    <Styles>
      <Style Name="Default" FontColor="#2A1A0EFF" FontSize="22"
             TextGlowRadius="0" TextBlur="0" TextShadowOffset="0"
             TextOutlineAmount="0.0" TextOutlineColor="#00000000" />
    </Styles>
  </Brush>

  <!--
    Cyrillic-safe siblings (player report: Galahad has no proper Cyrillic glyphs, so Russian rendered
    a broken per-glyph fallback). Font="FiraSansExtraCondensed-Regular", verified against this engine
    build's own Modules/Native/GUI/Fonts/NativeLanguages.xml, where it is BOTH the game's overall
    DefaultFont for English (the font "Default"-brushed widgets resolve to when no Font is set) and the
    id="Русский" entry's own DefaultFont/Galahad-mapping target. Same ink/size/alignment as their Galahad
    twin above; only the font differs. LetterViewModel picks between a brush and its .Plain sibling via
    LetterFontPolicy, see Letters/LetterFontResolver.cs.
  -->

  <Brush Name="CR.Letter.Body.Plain" Font="FiraSansExtraCondensed-Regular" TextHorizontalAlignment="Left" TextVerticalAlignment="Top">
    <Layers />
    <Styles>
      <Style Name="Default" FontColor="#2A1A0EFF" FontSize="23"
             TextGlowRadius="0" TextBlur="0" TextShadowOffset="0"
             TextOutlineAmount="0.0" TextOutlineColor="#00000000" />
    </Styles>
  </Brush>

  <Brush Name="CR.Letter.Heading.Plain" Font="FiraSansExtraCondensed-Regular" TextHorizontalAlignment="Center">
    <Layers />
    <Styles>
      <Style Name="Default" FontColor="#5A3C1CFF" FontSize="22"
             TextGlowRadius="0" TextBlur="0" TextShadowOffset="0"
             TextOutlineAmount="0.0" TextOutlineColor="#00000000" />
    </Styles>
  </Brush>

  <Brush Name="CR.Letter.Input.Plain" Font="FiraSansExtraCondensed-Regular" TextHorizontalAlignment="Left" TextVerticalAlignment="Center">
    <Layers />
    <Styles>
      <Style Name="Default" FontColor="#2A1A0EFF" FontSize="22"
             TextGlowRadius="0" TextBlur="0" TextShadowOffset="0"
             TextOutlineAmount="0.0" TextOutlineColor="#00000000" />
    </Styles>
  </Brush>

  <!--
    HISTORY (left page of the letter book) text brushes: same crisp Galahad ink as the letter body, but a
    SMALLER default size so the correspondence thread reads as secondary to the main letter on the right. The
    size lives here in the Style (the reliable knob: the widgets that use these brushes carry NO inline
    Brush.FontSize, so this is the single source of truth). To retune, change the FontSize here and restart the
    game (brush files are not hot-reloaded by cr.reload_ui). History.Body = the entry text; History.Meta = the
    dated attribution line above each entry (its colour is overridden per direction in the prefab).
  -->
  <Brush Name="CR.Letter.History.Body" Font="Galahad" TextHorizontalAlignment="Left" TextVerticalAlignment="Top">
    <Layers />
    <Styles>
      <Style Name="Default" FontColor="#2A1A0EFF" FontSize="16"
             TextGlowRadius="0" TextBlur="0" TextShadowOffset="0"
             TextOutlineAmount="0.0" TextOutlineColor="#00000000" />
    </Styles>
  </Brush>

  <Brush Name="CR.Letter.History.Body.Plain" Font="FiraSansExtraCondensed-Regular" TextHorizontalAlignment="Left" TextVerticalAlignment="Top">
    <Layers />
    <Styles>
      <Style Name="Default" FontColor="#2A1A0EFF" FontSize="16"
             TextGlowRadius="0" TextBlur="0" TextShadowOffset="0"
             TextOutlineAmount="0.0" TextOutlineColor="#00000000" />
    </Styles>
  </Brush>

  <Brush Name="CR.Letter.History.Meta" Font="Galahad" TextHorizontalAlignment="Left">
    <Layers />
    <Styles>
      <Style Name="Default" FontColor="#5A3C1CFF" FontSize="13"
             TextGlowRadius="0" TextBlur="0" TextShadowOffset="0"
             TextOutlineAmount="0.0" TextOutlineColor="#00000000" />
    </Styles>
  </Brush>

  <Brush Name="CR.Letter.History.Meta.Plain" Font="FiraSansExtraCondensed-Regular" TextHorizontalAlignment="Left">
    <Layers />
    <Styles>
      <Style Name="Default" FontColor="#5A3C1CFF" FontSize="13"
             TextGlowRadius="0" TextBlur="0" TextShadowOffset="0"
             TextOutlineAmount="0.0" TextOutlineColor="#00000000" />
    </Styles>
  </Brush>

</Brushes>
